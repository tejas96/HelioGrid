{
  "name": "heliogrid",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "bash scripts/lint-all.sh",
    "lint:fix": "biome check --write .",
    "boundaries": "turbo boundaries",
    "verify": "pnpm turbo build && pnpm lint && pnpm boundaries && pnpm turbo typecheck && pnpm turbo test",
    "precommit": "pnpm exec biome check --error-on-warnings --no-errors-on-unmatched --staged . && pnpm turbo typecheck",
    "check:adherence": "bash scripts/check-adherence.sh",
    "check:openapi": "node scripts/check-openapi-breaking.mjs",
    "check:dupes": "jscpd --config .jscpd.json apps packages",
    "check:unused": "knip",
    "check:env": "node scripts/check-env-access.mjs",
    "ds:contract": "node scripts/ds-contract.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run precommit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "dependency-cruiser": "16.10.4",
    "jscpd": "4.0.5",
    "knip": "5.88.1",
    "sherif": "1.13.0",
    "simple-git-hooks": "2.13.1",
    "turbo": "2.10.7",
    "typescript": "5.8.3"
  }
}
