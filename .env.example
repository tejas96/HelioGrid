# HelioGrid — every runtime variable, documented. Real values live in Fly secrets (prod) or
# .env.local (local) ONLY — never committed (.gitignore; CLAUDE.md hard rule).
#
# WHICH COMMANDS ACTUALLY READ .env.local
#   apps/api, apps/worker   dev + start + auth:migrate pass Node's
#                           --env-file-if-exists=../../.env.local, so it is loaded
#                           automatically. A REAL environment variable always WINS over the
#                           file, so Fly secrets and CI are never overridden.
#   apps/web                Next loads .env.local itself (built-in).
#   apps/mobile             Nothing — bare RN has no runtime environment. apps/mobile/src/env.ts
#                           supplies the value; see packages/env/src/native.ts.
#   COLD START, in order:   cp .env.example .env.local, then fill DATABASE_URL,
#                           DATABASE_ADMIN_URL and BETTER_AUTH_SECRET
#                           pnpm install --frozen-lockfile
#                           pnpm turbo build            <-- REQUIRED before anything below:
#                             workspace packages resolve through dist/, so a migrate or an
#                             auth:migrate on an unbuilt tree dies on MODULE_NOT_FOUND
#                           pnpm --filter @heliogrid/db migrate   (schema + roles)
#                           pnpm --filter @heliogrid/api auth:migrate  (Better Auth's own 7
#                           tables — jwks arrives with the jwt plugin, which is not enabled;
#                           the tenancy scan only WARNS without them)
#   db migrate, invariants  NOT loaded: these take the URL from the SHELL, because the value is
#                           expanded before Node starts. Export it for a session with:
#                             set -a; . ./.env.local; set +a
#
# What each variable MEANS and whether it may be absent is declared in packages/env/src/schema/.
# That is the source of truth for shape; this file is the source of truth for what exists.

# ── Service (declared in packages/env/src/schema/api.ts and worker.ts) ───────────
# All four have defaults IN THE SCHEMA, so they are optional here — set them to override.
# Non-secret defaults never live behind `??` at a call site (packages/env/CLAUDE.md).
NODE_ENV=development
PORT=8080
# Browser origin allowed by CORS + Better Auth trustedOrigins.
WEB_ORIGIN=http://localhost:3000
# Stamped by Fly on deploy; surfaced by the health endpoint. Defaults to 0.0.1 locally.
FLY_MACHINE_VERSION=0.0.1

# ── Database (Fly postgres-flex, bom) ────────────────────────────────────────────
# Runtime role for the api/worker (member of app_user; subject to RLS, no BYPASSRLS)
DATABASE_URL=postgres://app_runtime:CHANGE_ME@heliogrid-db.flycast:5432/heliogrid
# DDL/migration role (owner) — used ONLY by `pnpm --filter @heliogrid/db migrate`
# app_admin, NEVER the `postgres` superuser (docs/08 §4). It holds BYPASSRLS for the
# audited cross-tenant paths only; the api refuses to boot if DATABASE_URL's role is
# superuser or BYPASSRLS. Both roles are created by migration 0004; passwords are set
# out-of-band (`alter role app_admin password '…'`).
DATABASE_ADMIN_URL=postgres://app_admin:CHANGE_ME@heliogrid-db.flycast:5432/heliogrid

# ── Redis (Upstash via Fly extension, bom, FIXED plan, eviction OFF) ─────────────
# TCP/RESP endpoint — never the REST URL; BullMQ needs maxRetriesPerRequest: null
REDIS_URL=rediss://default:CHANGE_ME@fly-heliogrid-redis.upstash.io:6379

# ── Object storage (Tigris, single-region pin `sin`) ─────────────────────────────
AWS_ACCESS_KEY_ID=tid_CHANGE_ME
AWS_SECRET_ACCESS_KEY=tsec_CHANGE_ME
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
BUCKET_NAME=heliogrid-objects

# ── Auth (Better Auth self-hosted + MSG91 OTP) ───────────────────────────────────
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES
BETTER_AUTH_URL=https://api.heliogrid.in
MSG91_AUTH_KEY=CHANGE_ME
MSG91_OTP_TEMPLATE_ID=CHANGE_ME

# ── Billing (Razorpay platform subscriptions; tenant BYO keys live in DB, encrypted)
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
# Master key for per-tenant DEK envelopes (tenant_integration_credentials)
TENANT_CREDENTIALS_MASTER_KEY=CHANGE_ME_32_BYTES

# ── Voice (Exotel + Sarvam) ──────────────────────────────────────────────────────
EXOTEL_ACCOUNT_SID=CHANGE_ME
EXOTEL_API_KEY=CHANGE_ME
EXOTEL_API_TOKEN=CHANGE_ME
SARVAM_API_KEY=CHANGE_ME

# ── Solar data proxies (server-side only; SSRF-guarded relay) ────────────────────
GOOGLE_SOLAR_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
# PVGIS needs no key; its base URL is fixed in code

# ── Push (FCM service account for direct sends) ──────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON_BASE64=CHANGE_ME

# ── Web ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.heliogrid.in

# ── Observability (Grafana Cloud OTLP) ───────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-CHANGE_ME.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20CHANGE_ME

# ── Why this file and the schemas are not a 1:1 list ─────────────────────────────
# Two DECLARED keys are deliberately absent above:
#   CI       — set by the CI provider, never by a .env file. Read by the invariants runner
#              to fail closed instead of skipping (tests/invariants/src/run.ts).
#   API_URL  — apps/mobile's, and it is platform-determined rather than deployment-determined
#              (Android emulator 10.0.2.2 vs iOS simulator localhost), so apps/mobile/src/env.ts
#              supplies it. It gains an entry here when a deployed mobile API URL exists.
#
# Conversely, keys above whose module has not been built yet (Tigris, Razorpay, Exotel,
# Sarvam, Google Solar, Gemini, FCM, OTEL) have NO schema in packages/env yet, on purpose:
# Law 9 authors a variable's schema when its owning module's slice begins. This file is the
# deployment contract for the whole system; the schemas grow into it module by module.
