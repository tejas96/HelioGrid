{
  "name": "@heliogrid/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-workflow-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/main.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/main.js",
    "build:workflows": "node scripts/build-workflow-bundle.mjs"
  },
  "dependencies": {
    "@heliogrid/contracts": "workspace:*",
    "@heliogrid/db": "workspace:*",
    "@heliogrid/env": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@temporalio/worker": "1.22.0",
    "@temporalio/workflow": "1.22.0",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.8.3"
  }
}
