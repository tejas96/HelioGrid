<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base application theme.

      DayNight: the app follows the device's scheme, or the one picked in Profile & preferences
      (React Native's Appearance sets AppCompat's night mode). Every colour is `hg_<token>` from
      @heliogrid/theme's generated values and values-night, which build.gradle adds as a resource
      folder.

      `windowBackground` IS the splash on API 24–30. From API 31 the system owns the splash
      and ignores this attribute entirely — see values-v31/styles.xml. minSdk is 24 and
      targetSdk 36, so both ranges ship and both get tested.

      The splash and the bars take @color/hg_canvas, so they follow the scheme. Never hardcode a hex here.
    -->
    <!--
      The bottom system bar, by API range. Here, API 24–26: the platform cannot draw dark
      buttons on a light bar, so the bar keeps the platform's own dark ground. values-v27
      holds the light bar. AppTheme inherits it in both of its files.
    -->
    <style name="AppTheme.SystemBars" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="AppTheme" parent="AppTheme.SystemBars">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:textViewStyle">@style/AppTheme.Text</item>
        <item name="android:windowBackground">@color/hg_canvas</item>
        <!-- A transparent status bar whose icons are dark in light and light in dark. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/hg_light_bars</item>
        <!-- The app draws its own dark: Android must never darken it on its own (forced dark). -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!--
      Every React Native `Text` is a TextView that takes this style. Here it adds nothing; values-v35
      turns off the API 35 width rule that makes a Devanagari line wrap inside its own box.
    -->
    <style name="AppTheme.Text" parent="Widget.AppCompat.TextView" />

</resources>
