<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base application theme.

      NOT DayNight. This product is light-only v1, there are no values-night
      resources, and a DayNight parent was wrong by declaration even though it was inert.

      `windowBackground` IS the splash on API 24–30. From API 31 the system owns the splash
      and ignores this attribute entirely — see values-v31/styles.xml. minSdk is 24 and
      targetSdk 36, so both ranges ship and both get tested.

      @color/splash_canvas has no generator: it is set by hand to match @heliogrid/theme (deferred D114).
      Never hardcode a hex here.
    -->
    <!--
      The bottom system bar, by API range. Here, API 24–26: the platform cannot draw dark
      buttons on a light bar, so the bar keeps the platform's own dark ground. values-v27
      holds the light bar. AppTheme inherits it in both of its files.
    -->
    <style name="AppTheme.SystemBars" parent="Theme.AppCompat.Light.NoActionBar" />

    <style name="AppTheme" parent="AppTheme.SystemBars">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:textViewStyle">@style/AppTheme.Text</item>
        <item name="android:windowBackground">@color/splash_canvas</item>
        <!-- A transparent status bar with dark icons before the app's code loads: the design is white. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Light-only (F7-04): without this Android may darken a light app on its own (forced dark). -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!--
      Every React Native `Text` is a TextView that takes this style. Here it adds nothing; values-v35
      turns off the API 35 width rule that makes a Devanagari line wrap inside its own box.
    -->
    <style name="AppTheme.Text" parent="Widget.AppCompat.TextView" />

</resources>
