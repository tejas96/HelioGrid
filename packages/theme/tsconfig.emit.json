{
  "$schema": "https://json.schemastore.org/tsconfig",
  /* Deliberately extends NOTHING. It compiles the TypeScript that build.ts wrote into dist (the
     theme object, and the token sources it copies there), not this package's src, so the
     workspace base — which targets src, forbids emit and sets paths this tree does not have —
     would fight it. CommonJS output beside the .d.ts, from dist, into dist. */

  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "dist",
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["dist/**/*.ts"],
  "exclude": ["dist/**/*.d.ts"]
}
