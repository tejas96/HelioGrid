{
  "name": "@heliogrid/theme",
  "version": "0.0.1",
  "private": true,
  "description": "Design tokens — one typed source (src/tokens), emitted as web CSS (light, dark, field), the phone theme object and Android colour resources.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./print.css": "./dist/print.css",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./contrast.pairs.json": "./dist/contrast.pairs.json",
    "./fonts/*": "./dist/fonts/*",
    "./android-res/*": "./dist/android-res/*"
  },
  "scripts": {
    "build": "tsx build.ts && tsc -p tsconfig.emit.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@types/fontkit": "2.0.9",
    "@types/node": "22.20.1",
    "fontkit": "2.0.4",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vitest": "5.0.0"
  }
}
