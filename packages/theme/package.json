{
  "name": "@heliogrid/theme",
  "version": "0.0.1",
  "private": true,
  "description": "GENERATED design tokens + RN theme — parsed from src/_generated (ds:pull, docs/17 §6). Never hand-edited, never hand-transcribed.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./print.css": "./dist/print.css",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./contrast.pairs.json": "./dist/contrast.pairs.json",
    "./fonts/*": "./dist/fonts/*"
  },
  "scripts": {
    "build": "tsx build.ts && tsc -p tsconfig.emit.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.8.3"
  }
}
