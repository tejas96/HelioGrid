{
  "name": "@heliogrid/tokens",
  "version": "0.0.1",
  "private": true,
  "description": "GENERATED design tokens — parsed from design/ds-source/tokens/*.css (docs/10 §2). Never hand-edited, never hand-transcribed.",
  "scripts": {
    "build": "tsx build.ts && tsc -p tsconfig.emit.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./contrast.pairs.json": "./dist/contrast.pairs.json",
    "./fonts/*": "./dist/fonts/*"
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.8.3"
  },
  "turbo": {
    "tags": [
      "tokens"
    ]
  }
}
