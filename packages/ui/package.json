{
  "name": "@heliogrid/ui",
  "version": "0.0.1",
  "private": true,
  "description": "V2 design system — ONE package, both platforms (docs/engineering/17 §2). Ships SOURCE: Next transpiles the .tsx halves, Metro resolves .native.tsx ahead of them. Primitives own the product law (44px targets, status never colour alone).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.native.json"
  },
  "dependencies": {
    "@heliogrid/domain": "workspace:*",
    "@heliogrid/theme": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-svg": "15.15.5"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-svg": "15.15.5",
    "typescript": "5.8.3"
  }
}
