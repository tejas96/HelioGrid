// An icon is drawn by name with ShellGlyph, never by a component's own <svg> — no box of its own,
// no <path>, <circle>, <rect>, <line>, <polyline>, <polygon> or <ellipse> (web or react-native-svg),
// so every icon keeps the one ladder and the one stroke. The files that draw computed shapes rather
// than icons — charts, rings, the QR code's modules, the map's vectors, the empty scenes, the
// brand's gradient art, the icon module's own factory — are left out by biome.json's `includes`;
// `inline-glyph` still refuses path data there. It cannot see a mark imported under another name
// (`import { Path as P }`).
or {
  JsxOpeningElement(name=$name),
  JsxSelfClosingElement(name=$name)
} as $mark where {
  $name <: or {
    "svg",
    "Svg",
    "path",
    "Path",
    "circle",
    "Circle",
    "rect",
    "Rect",
    "line",
    "Line",
    "polyline",
    "Polyline",
    "polygon",
    "Polygon",
    "ellipse",
    "Ellipse"
  },
  register_diagnostic(span=$mark, message="An icon drawn by hand — draw it by name with ShellGlyph; a new icon joins SHELL_GLYPHS (AppShell/ShellGlyph.icons.ts).")
}
