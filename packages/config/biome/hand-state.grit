// A design-system surface takes its read as `read={read}` (SurfaceRead,
// packages/ui/src/components/UnavailableNote/UnavailableNote.types.ts), whose failed read always
// carries its retry. A screen writes no `state` by hand: the few parts that still take one
// (UsageMeter, Image, Dropzone…) draw a failed state with no retry the type can hold. An object
// (`state={{ … }}`) is another component's own prop, not a read state.
JsxAttribute() as $attribute where {
  $attribute <: r"state=(?:[\x22\x27]|\{[^{])[\s\S]*",
  register_diagnostic(span=$attribute, message="A state written by hand — pass the screen's read as read={read} instead.")
}
