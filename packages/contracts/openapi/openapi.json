{
  "openapi": "3.0.2",
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness — process is up",
        "tags": ["health"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "service", "version"]
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness — dependencies reachable (DB when configured)",
        "tags": ["health"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "enum": ["ok", "skipped", "failed"]
                      }
                    }
                  },
                  "required": ["status", "checks"]
                }
              }
            }
          },
          "503": {
            "description": "503",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": ["INTERNAL"]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "issue": {
                                "type": "string"
                              }
                            },
                            "required": ["path", "issue"]
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message", "requestId"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    }
  },
  "info": {
    "title": "HelioGrid API",
    "version": "0.0.1",
    "description": "Contract-first surface. Errors follow the canonical envelope { error: { code, message, details?, requestId } }."
  }
}
