{
  "openapi": "3.0.2",
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness — process is up",
        "tags": [
          "health"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness — dependencies reachable (DB when configured)",
        "tags": [
          "health"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "ok",
                          "skipped",
                          "failed"
                        ]
                      }
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "503",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "INTERNAL"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "issue": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "issue"
                            ]
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "requestId"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/market-packs/{marketCode}": {
      "get": {
        "summary": "The current published version of one market pack, without the price book",
        "tags": [
          "marketPack"
        ],
        "parameters": [
          {
            "name": "marketCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "market": {
                      "type": "string",
                      "pattern": "^[A-Z]{2}$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "publishedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "version": {
                      "type": "string"
                    },
                    "tax": {
                      "nullable": true
                    },
                    "subsidy": {
                      "nullable": true
                    },
                    "callingRules": {
                      "nullable": true
                    },
                    "paymentRails": {
                      "nullable": true
                    },
                    "certificationSchemes": {
                      "nullable": true
                    },
                    "formats": {
                      "nullable": true
                    },
                    "dataRights": {
                      "nullable": true
                    }
                  },
                  "required": [
                    "market",
                    "revision",
                    "publishedAt",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "NOT_FOUND"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "issue": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "issue"
                            ]
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "requestId"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "info": {
    "title": "HelioGrid API",
    "version": "0.0.1",
    "description": "Contract-first surface. Errors follow the canonical envelope { error: { code, message, details?, requestId } }."
  }
}
