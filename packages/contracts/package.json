{
  "name": "@heliogrid/contracts",
  "version": "0.0.1",
  "private": true,
  "description": "ts-rest + Zod 3 contracts — the API review surface. Edited BEFORE any endpoint or client.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "openapi": "node dist/scripts/emit-openapi.js"
  },
  "dependencies": {
    "@heliogrid/domain": "workspace:*",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/open-api": "3.52.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@types/node": "22.20.1",
    "typescript": "5.8.3"
  }
}
