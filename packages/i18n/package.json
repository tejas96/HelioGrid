{
  "name": "@heliogrid/i18n",
  "version": "0.0.1",
  "private": true,
  "description": "ONE Lingui catalog (EN/HI/MR) for Next.js AND bare RN — message source of truth is runtime <Trans id=\"<English text>\"/>, extracted to .po",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./rn": {
      "types": "./dist/rn/index.d.ts",
      "default": "./dist/rn/index.js"
    }
  },
  "scripts": {
    "extract": "lingui extract --clean",
    "compile": "lingui compile --typescript",
    "build": "lingui compile --typescript && tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@formatjs/intl-locale": "5.3.10",
    "@formatjs/intl-pluralrules": "6.3.13",
    "@heliogrid/contracts": "workspace:*",
    "@lingui/core": "5.9.5",
    "@lingui/react": "5.9.5"
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@lingui/cli": "5.9.5",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "react": "19.2.3",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "react": "19.2.3"
  }
}
