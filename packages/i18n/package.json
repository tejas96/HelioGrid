{
  "name": "@heliogrid/i18n",
  "version": "0.0.1",
  "private": true,
  "description": "ONE Lingui catalog (EN/HI/MR) for Next.js AND bare RN — message source of truth is runtime <Trans id=\"<English text>\"/>, extracted to .po (docs/10 §7)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "extract": "lingui extract --clean",
    "compile": "lingui compile --typescript",
    "build": "lingui compile --typescript && tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@heliogrid/contracts": "workspace:*",
    "@lingui/core": "5.9.5"
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@lingui/cli": "5.9.5",
    "@types/node": "22.20.1",
    "typescript": "5.8.3"
  },
  "turbo": {
    "tags": [
      "i18n"
    ]
  }
}
