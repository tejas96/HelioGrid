{
  "name": "@heliogrid/data",
  "version": "0.0.1",
  "private": true,
  "description": "The frontend SDK — the ONLY data path for apps/web and apps/mobile (ADR-0023)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@heliogrid/contracts": "workspace:*",
    "@heliogrid/domain": "workspace:*",
    "@ts-rest/core": "3.52.1",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@heliogrid/config": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "happy-dom": "20.14.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.8.3",
    "vitest": "5.0.0"
  }
}
