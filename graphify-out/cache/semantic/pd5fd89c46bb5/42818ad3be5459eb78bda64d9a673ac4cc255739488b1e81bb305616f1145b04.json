{"nodes": [{"id": "docs_adr_0019_telephony_platform_capability_framework_adr_0019", "label": "ADR-0019: Telephony as a platform capability framework", "file_type": "document", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two forces broke the Exotel-shaped framing: the owner directive that telephony is a long-term PLATFORM capability which must never need refactoring to grow, and Spike S5 proving parts of the Exotel-shaped interface are not real on Exotel. A 1:1-with-the-vendor interface would have baked a vendor's gaps into product law."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_telephonycoreport", "label": "TelephonyCorePort (required core)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "placeOutbound, onInbound, mediaStream, hangup and getCapabilities are required of every adapter in packages/adapters/telephony \u2014 a small honest core instead of one grand interface."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_telephonycapabilities", "label": "TelephonyCapabilities declaration", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static, honest, per adapter+account flags (dtmfSend/Receive, transferCold/Warm, conference, recording, monitoring, voicemail, queueing, numberProvisioning, inboundIvr) \u2014 the Exotel adapter declares dtmfSend:false rather than hiding the gap in code paths."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_capability_negotiation", "label": "Capability negotiation \u2014 branch on the declaration, never the vendor name", "file_type": "rationale", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-vendor business-logic branches are the thing this ADR exists to kill; a new provider implements the core plus whatever is real, declares honestly, and maps a phone_provider enum value."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_dtmfcapable", "label": "DtmfCapable (optional interface)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0019_telephony_platform_capability_framework_transfercapable", "label": "TransferCapable (consult / bridge / redirect)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0019_telephony_platform_capability_framework_conferencecapable", "label": "ConferenceCapable (optional interface)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0019_telephony_platform_capability_framework_recordingcapable", "label": "RecordingCapable (optional interface)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0019_telephony_platform_capability_framework_monitoringcapable", "label": "MonitoringCapable (listen / whisper / barge)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0019_telephony_platform_capability_framework_voicemailcapable", "label": "VoicemailCapable (optional interface)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0019_telephony_platform_capability_framework_degradation_ladder", "label": "Defined degradation ladder", "file_type": "rationale", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A feature needing a missing capability degrades along the docs/07 \u00a74 matrix \u2014 it never throws and never silently no-ops. Outbound IVR traversal needs dtmfSend; without it the campaign step is skipped and the call is flagged ivr_blocked for human follow-up."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_callorchestrator", "label": "CallOrchestrator (call-control plane)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider-agnostic owner of the call-leg state machine (ai_handling \u2192 handoff_pending \u2192 consulting \u2192 bridged \u2192 completed, plus callback_queued, voicemail, failed); executes routing plans, enforces ComplianceGate before every dial including consult legs, and writes the calls/call_handoffs ledger. Vendor adapters only move legs."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_callsession_media_plane", "label": "CallSession (media/AI plane, unchanged)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "STT\u2192LLM\u2192TTS turn-taking, barge-in, AI disclosure \u226430s and outcome classification; talks only to SpeechProvider, LanguageModel and the media half of the core port."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_routing_policies", "label": "routing_policies \u2014 routing and escalation as TENANT DATA", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Versioned-append JSONB documents with D36-style pinning: ordered when(conditions) \u2192 then(action) rules over AI confidence, customer request, intent/department, priority, business hours, VIP status and retry count. Escalation chains are data, so the executor never changes to add a level."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_ring_groups", "label": "ring_groups (round_robin / simultaneous / longest_idle)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0019_telephony_platform_capability_framework_escalation_chains", "label": "Escalation chains with an always-reachable final fallback", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered levels with per-level ring timeout and no-answer fallthrough; the final fallback is ALWAYS callback queue or voicemail so a caller is never stranded."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_call_handoffs", "label": "call_handoffs \u2014 context travels with every handoff", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Append-only summary, intent, sentiment, collected fields, transcript pointer, target, kind and outcome. The summary is generated ONCE at handoff decision time and pinned, so the human sees what the AI knew."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_whisper_summary", "label": "Warm-transfer whisper summary", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TTS summary delivered to the human before bridging (requires transferWarm); cold transfers push the summary via notification plus timeline deep-link."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_spike_s5", "label": "Spike S5 findings (2026-07-25)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No documented DTMF-send on AgentStream, BYO numbers are inbound-forwarding rather than porting, and the 1600 series is closed to non-BFSI \u2014 so promotional outbound uses the 140-series RTM route and product copy must say forwarding."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_compliance_fail_closed", "label": "ComplianceGate stays ours and fail-closed", "file_type": "rationale", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The control plane classifies every leg as promotional / transactional / internal and gates accordingly, before every dial."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_phone_provider_registry", "label": "Adapter registry keyed by phone_provider enum", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0019_telephony_platform_capability_framework_launch_vs_platform_scope", "label": "Launch scope vs platform seam matrix", "file_type": "rationale", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Track C ships AI-first handling, cold transfer, callback queue and DTMF receive; warm transfer ships only if the Exotel sandbox verifies consult legs by Day 11 and otherwise auto-degrades to cold; conference/monitoring/voicemail get interfaces and schema seams only."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_track_c_migration", "label": "Track C first migration (schema seams)", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ring_groups, routing_policies, call_handoffs, user_presence, call_queue callback fields and calls.outcome += transferred are specified now in docs/04 \u00a78 so earlier tracks leave room."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_ccaas_suite", "label": "Rejected: building on a CCaaS suite", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds a vendor exactly where we are removing coupling."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_one_grand_interface_throws", "label": "Rejected: one grand interface with UnsupportedOperation throws", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns product flows into try/catch vendor probing."}, {"id": "docs_adr_0019_telephony_platform_capability_framework_per_vendor_branches", "label": "Rejected: per-vendor business logic branches", "file_type": "concept", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exact failure mode this ADR exists to kill."}, {"id": "docs_07_integrations_integrations", "label": "docs/07 \u2014 integrations (telephony port matrix \u00a74, ComplianceGate \u00a76)", "file_type": "document", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_data_model_data_model", "label": "docs/04 \u2014 data model", "file_type": "document", "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_0019_telephony_platform_capability_framework_adr_0019", "target": "docs_adr_0012_voice_exotel_sarvam_adr_0012", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0019_telephony_platform_capability_framework_telephonycoreport", "target": "docs_adr_0012_voice_exotel_sarvam_telephonyprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0019-telephony-platform-capability-framework.md", "source_location": null, "weight