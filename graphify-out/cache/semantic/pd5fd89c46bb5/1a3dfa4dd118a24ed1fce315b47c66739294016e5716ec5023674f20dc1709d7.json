{"nodes": [{"id": "design_ds_source_readme_heliogrid_design_system", "label": "HelioGrid Design System (design/ds-source)", "file_type": "document", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users quote jobs worth \u20b95\u201350 lakh on mid-range Android phones, often on a roof with poor signal \u2014 so the character is precision instrument, not sales toy, with both 375px and 1440px first-class."}, {"id": "design_ds_source_readme_governing_rule_luminance", "label": "The one governing rule \u2014 hierarchy from luminance and softness, never lines", "file_type": "rationale", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No 1px grey borders anywhere (only dashed drop zones and an opt-in high-contrast field mode); depth is blur + desaturation, never dimming \u2014 overlays fade toward white, never a dark scrim. Restraint is the premium signal."}, {"id": "design_ds_source_readme_density_modes", "label": "Two density modes \u2014 Expressive and Functional", "file_type": "concept", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same colours, type and rules; only spacing and radius change. Expressive default on mobile, Functional on desktop data screens \u2014 and Functional still has no borders, rows alternate #FFFFFF/#FAFBFC."}, {"id": "design_ds_source_readme_iridescence_atmosphere", "label": "Iridescence is atmosphere; the primary action is near-black", "file_type": "rationale", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Violet\u2192blue\u2192magenta appears only as gradient/glow/icon-wash/AI cue and never fills a button, row, chip or field; accent #5A4BFF drives focus, links and control fills. Near-black #0A0A0B primary is the strongest identity marker."}, {"id": "design_ds_source_readme_geist_typography", "label": "Geist typography and the overline signature device", "file_type": "concept", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 400 and 700 in normal use (500 for buttons/tabs/table headers); headings tightly tracked \u22120.02 to \u22120.03em; 11px/700/0.12em uppercase overline; all numeric data tabular-nums, currency right-aligned."}, {"id": "design_ds_source_readme_statuschip", "label": "StatusChip \u2014 solar workflow states to fixed semantic colours + dot", "file_type": "concept", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lead / survey-scheduled / design-in-progress / approved / installing / commissioned / on-hold, with a status dot so status is never conveyed by colour alone."}, {"id": "design_ds_source_readme_iconcircle", "label": "IconCircle \u2014 the signature circular icon container", "file_type": "concept", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ds_source_readme_offlinebanner", "label": "OfflineBanner \u2014 field-app offline queue banner", "file_type": "concept", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ds_source_readme_token_files", "label": "tokens/ CSS files and styles.css entry point", "file_type": "concept", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fonts, colors, typography, spacing, radius, elevation, motion, base \u2014 the single entry point consumers link."}, {"id": "design_ds_source_readme_content_fundamentals", "label": "Content fundamentals \u2014 sentence case, verb buttons, domain language", "file_type": "rationale", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buttons are verbs, never Submit/OK/Click here; errors state the problem AND the fix and never expose codes to field users; numbers always carry units; currency in Indian grouping; no emoji."}, {"id": "design_ds_source_readme_lucide_iconography", "label": "Lucide iconography at 1.5px stroke", "file_type": "concept", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never mix filled and outlined in one context; filled only for the active bottom-nav item; no icon font, no emoji, no unicode-as-icon; brand/AI features use a gradient object."}, {"id": "design_ds_source_readme_no_logo_mark", "label": "No HelioGrid logo mark \u2014 wordmark in Geist Bold", "file_type": "rationale", "source_file": "design/ds-source/readme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No logo asset was provided and one must not be invented."}], "edges": [{"source": "design_ds_source_readme_heliogrid_design_system", "target": "design_ds_source_readme_governing_rule_luminance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/ds-source/readme.md", "source_location": null, "weight": 1.0}, {"source": "design_ds_source_readme_heliogrid_design_system", "target": "design_ds_source_readme_density_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/ds-source/readme.md