{"nodes": [{"id": "docs_adr_0015_i18n_lingui_v5_adr_0015", "label": "ADR-0015: i18n \u2014 Lingui v5, one catalog for Next.js and bare RN", "file_type": "document", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One EN/HI/MR catalog must serve Next.js App Router (including RSC) and bare React Native, with per-user language switching that re-renders immediately (D25). Lingui is the only compile-time option that covers RN at all."}, {"id": "docs_adr_0015_i18n_lingui_v5_lingui_v5", "label": "Lingui v5", "file_type": "concept", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compile-based (small bundles, native ICU MessageFormat) with a lightweight runtime for per-user locale switching; Next.js App Router + RSC officially supported."}, {"id": "docs_adr_0015_i18n_lingui_v5_packages_i18n_catalog", "label": "packages/i18n \u2014 the single message catalog", "file_type": "concept", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0015_i18n_lingui_v5_lingui_metro_transformer", "label": "@lingui/metro-transformer (bare RN)", "file_type": "concept", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified without Expo on RN \u22650.73 via babelTransformerPath plus po/pot sourceExts and FormatJS polyfills; flagged relatively new/beta and .po/.pot-only, so versions are pinned with a smoke check in the mobile CI lane."}, {"id": "docs_adr_0015_i18n_lingui_v5_noto_sans_devanagari", "label": "Devanagari rendering (Noto Sans chain)", "file_type": "concept", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit RN fallback handling is required."}, {"id": "docs_adr_0015_i18n_lingui_v5_d25_per_user_locale", "label": "D25 \u2014 per-user immediate locale switch", "file_type": "rationale", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Marathi surveyor and an English owner in the same company means the whole app re-renders on switch, without reloads \u2014 a runtime switch, not a build-time locale."}, {"id": "docs_adr_0015_i18n_lingui_v5_natural_language_ids", "label": "Natural-language message IDs require extraction discipline", "file_type": "rationale", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key type-safety comes from extraction plus messages.ts rather than typed functions, so copy edits change IDs."}, {"id": "docs_adr_0015_i18n_lingui_v5_paraglide_inlang", "label": "Rejected: Paraglide (inlang)", "file_type": "concept", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-in-class type safety but no first-class React Native support \u2014 a dealbreaker for the field app."}, {"id": "docs_adr_0015_i18n_lingui_v5_i18next", "label": "Rejected: i18next", "file_type": "concept", "source_file": "docs/adr/0015-i18n-lingui-v5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs everywhere but runtime-heavy, and key type-safety needs declaration-merging boilerplate agents get wrong."}, {"id": "docs_adr_0015_i18n_lingui_v5_formatjs_react_intl", "label": "Rejected: FormatJS / react-intl", "file_type": "concept", "source_file": "docs/