{"nodes": [{"id": "_claude_skills_qa_skill_qa_loop", "label": "/qa \u2014 plan in Claude, execute in agy, loop until clean", "file_type": "document", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Green gates never prove behaviour; a slice that was never run was never verified. Ends on exactly one of two conditions: a clean full certify run, or three fix rounds with failures remaining."}, {"id": "_claude_skills_qa_skill_phase0_preflight", "label": "Phase 0 \u2014 preflight, fail loudly by name", "file_type": "rationale", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A QA run that silently skips a surface is the exact failure the replaced files warned about; two programs are named agy and the IDE launcher exits zero while dispatching into a GUI panel no script can read."}, {"id": "_claude_skills_qa_skill_agy_executor", "label": "Antigravity CLI (agy) as the QA executor", "file_type": "concept", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude decides what to test and fixes what breaks; agy executes. --json-schema enforces the report shape at the CLI layer rather than trusting the prompt."}, {"id": "_claude_skills_qa_skill_blast_radius_from_diff", "label": "Phase 1 \u2014 blast radius computed from the working diff", "file_type": "rationale", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git is manual here so work is normally uncommitted on main; git diff main...HEAD resolves to nothing and an empty blast radius produces an empty plan that reads exactly like a clean run."}, {"id": "_claude_skills_qa_skill_plan_json", "label": "plan.json \u2014 the QA plan artifact", "file_type": "concept", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity is decided in the plan, never by the executor; anything touching money reconciliation, tenancy isolation or provenance tiers is authored blocker."}, {"id": "_claude_skills_qa_skill_quadrant_coverage_gate", "label": "Zero-cell abort \u2014 steps counted per (surface \u00d7 quadrant)", "file_type": "rationale", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plan may be small; it may not be lopsided. A surface that cannot be exercised is recorded as blocked with its reason, never silently omitted."}, {"id": "_claude_skills_qa_skill_add_dir_silent_false_pass", "label": "--add-dir omission is a perfect silent false pass", "file_type": "rationale", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it the run reports status SUCCESS with \"DONE\", burns tokens, takes ~26 seconds and does nothing; num_turns reported 1 both when real work happened and when none did."}, {"id": "_claude_skills_qa_skill_verify_report_before_believing", "label": "Phase 4 \u2014 verify the report before believing it", "file_type": "rationale", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fast model's failure mode is reporting a pass it did not earn: a pass whose artifact is missing is rewritten to inconclusive, and one contradicted spot-check escalates the whole run as untrusted."}, {"id": "_claude_skills_qa_skill_triage_four_buckets", "label": "Phase 5 \u2014 triage into bug / product-question / false-positive / environment", "file_type": "concept", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A product-question is recorded in docs/13 or docs/15 rather than invented, and does not block a clean run; an environment failure does not consume a fix round."}, {"id": "_claude_skills_qa_skill_three_fix_rounds_hard_stop", "label": "Hard stop after three fix rounds; never edit plan.json to hide a failure", "file_type": "rationale", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stated explicitly because a fix loop under pressure will eventually rationalize deleting a step; each round also re-runs a fresh blast radius for the code the fix touched."}, {"id": "_claude_skills_qa_skill_evidence_retention", "label": "Phase 7 \u2014 retention and committed evidence", "file_type": "rationale", "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "plan.json, runbook.md, report.json and triage.md are committed history; artifacts are deleted only after a clean certify pass and kept whenever a run escalated."}], "edges": [{"source": "_claude_skills_qa_skill_qa_loop", "target": "_claude_skills_qa_skill_phase0_preflight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_qa_loop", "target": "_claude_skills_qa_skill_blast_radius_from_diff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_qa_loop", "target": "_claude_skills_qa_skill_plan_json", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_qa_loop", "target": "_claude_skills_qa_skill_agy_executor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_qa_loop", "target": "_claude_skills_qa_skill_verify_report_before_believing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_qa_loop", "target": "_claude_skills_qa_skill_triage_four_buckets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_qa_loop", "target": "_claude_skills_qa_skill_three_fix_rounds_hard_stop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_qa_loop", "target": "_claude_skills_qa_skill_evidence_retention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_plan_json", "target": "_claude_skills_qa_references_test_matrix_four_quadrants", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/qa/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_qa_skill_quadrant_coverage_gate", "target": "_claude_skills_qa_references_test_matrix_four_quadrants", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"