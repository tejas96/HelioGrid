{"nodes": [{"id": "docs_adr_0016_no_feature_flags_adr_0016", "label": "ADR-0016: No feature-flag system \u2014 entitlements-only gating", "file_type": "document", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binding owner directive. Flag systems accrete permanent conditional debt, and for AI agents every flag doubles the code paths that must be reasoned about \u2014 dead branches are ambient falsehood that misleads an agent reading the code."}, {"id": "docs_adr_0016_no_feature_flags_entitlements_only_gating", "label": "Entitlements are the only runtime gating", "file_type": "concept", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An entitlement row maps to a purchasable plan capability, never to a deploy stage \u2014 entitlements must not be abused as covert flags."}, {"id": "docs_adr_0016_no_feature_flags_trunk_discipline", "label": "Trunk discipline \u2014 small complete verifiable slices", "file_type": "concept", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Features ship enabled when merged and incomplete work does not merge; large features must be decomposed into independently shippable slices \u2014 a forcing function accepted on purpose. Work that cannot be sliced waits on a branch, it does not merge dark."}, {"id": "docs_adr_0016_no_feature_flags_no_kill_switch", "label": "No kill switch \u2014 rollback by redeploy", "file_type": "rationale", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fly Machines deploys make rollback minutes not hours, but it is honest to say incidents lose one mitigation lever; no gradual rollouts or canaries at the app layer, so risk management moves wholly to slice size and pre-merge verification."}, {"id": "docs_adr_0016_no_feature_flags_one_code_path", "label": "One code path per feature \u2014 what an agent reads is what runs", "file_type": "rationale", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No flag-cleanup backlog and no flag-state combinatorics in testing, which matters double given the deliberately thin test net."}, {"id": "docs_adr_0016_no_feature_flags_tenant_configuration_escape_hatch", "label": "Per-tenant operational toggles are explicit tenant configuration", "file_type": "concept", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a genuine toggle becomes unavoidable it is modelled as configuration with product meaning, not a flag framework."}, {"id": "docs_adr_0016_no_feature_flags_launchdarkly_unleash_flagsmith", "label": "Rejected: LaunchDarkly / Unleash / Flagsmith", "file_type": "concept", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flag infrastructure for a product that forbids the practice \u2014 pure cost."}, {"id": "docs_adr_0016_no_feature_flags_homegrown_flags_table", "label": "Rejected: homegrown flags table", "file_type": "concept", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same debt without the tooling; historically becomes the junk drawer of half-shipped work."}, {"id": "docs_adr_0016_no_feature_flags_env_var_toggles", "label": "Rejected: env-var toggles", "file_type": "concept", "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags with worse observability; also banned."}], "edges": [{"source": "docs_adr_0016_no_feature_flags_adr_0016", "target": "docs_adr_0016_no_feature_flags_entitlements_only_gating", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_no_feature_flags_entitlements_only_gating", "target": "docs_adr_0013_billing_razorpay_inhouse_entitlements_adr_0013", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_no_feature_flags_entitlements_only_gating", "target": "docs_adr_0013_billing_razorpay_inhouse_entitlements_entitlements_postgres", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_no_feature_flags_adr_0016", "target": "docs_adr_0016_no_feature_flags_trunk_discipline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_no_feature_flags_one_code_path", "target": "docs_adr_0016_no_feature_flags_adr_0016", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-no-feature-flags.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_no_feature_flags_no_kill_switch", "target": "docs_adr_0016_no_feature_flags_trunk_discipline", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-no-feature-flags.md", "source_locat