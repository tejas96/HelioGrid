{"nodes": [{"id": "docs_16_billing_and_entitlements_subscription_lifecycle", "label": "Subscription Lifecycle State Machine", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reactivation creates a NEW Razorpay subscription rather than resuming a halted one \u2014 a clean cut with one live mandate at a time; data is retained indefinitely regardless of how long the tenant was halted."}, {"id": "docs_16_billing_and_entitlements_soft_block_matrix", "label": "Soft-Block Matrix (per subscription state)", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Paused' in late past_due covers only features that cost per-use money; core selling continues through the whole grace window, and the block is on new mutations from the UI, never on draining a field crew's already-captured queue."}, {"id": "docs_16_billing_and_entitlements_read_export_always_work", "label": "Read + Export ALWAYS Work (product law)", "file_type": "rationale", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never hold an EPC's customer data hostage; no schema mechanism may do so, dunning copy carries no deletion threats because nothing is deleted, and customer links stay live in every billing state."}, {"id": "docs_16_billing_and_entitlements_razorpay_webhooks", "label": "Razorpay Webhook Pipeline (verify \u2192 dedupe \u2192 fast 2xx \u2192 queue \u2192 poll)", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Razorpay delivers at-least-once with duplicates and reordering guaranteed, so these patterns are mandatory rather than optional; reconciliation-by-poll should be boring, and any repair emits an alert."}, {"id": "docs_16_billing_and_entitlements_entitlements_model", "label": "Entitlements Model \u2014 the ONLY runtime gating", "file_type": "rationale", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There are no feature flags in this product; features ship enabled when merged, and the single runtime gate is plan entitlements plus usage allowances."}, {"id": "docs_16_billing_and_entitlements_enforcement_points", "label": "Enforcement Points (the complete list)", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design capacity is gated at save/creation, never mid-edit, so the flagship is never interrupted per-keystroke; adding a gated feature means adding a row to this table."}, {"id": "docs_16_billing_and_entitlements_usage_metering", "label": "Usage Metering (the ledger is the bill)", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tenant-visible usage screen shows exactly the rollups we enforce and bill from \u2014 same query, same numbers, no smoothing; if a bundle is 80% consumed the screen says so before the gate ever fires."}, {"id": "docs_16_billing_and_entitlements_gst_invoicing", "label": "GST Invoicing (we are supplier of record)", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Razorpay is a gateway, not merchant-of-record, so the GSTIN, remittance and IRN liability are ours; invoice rows already carry nullable IRN fields so crossing the e-invoicing threshold needs no backfill."}, {"id": "docs_16_billing_and_entitlements_byo_razorpay_collections", "label": "Tenant Customer-Collections via BYO Razorpay", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The platform never touching funds is the load-bearing regulatory line; Razorpay Route is rejected for now because it would make us the KYC-bearing master merchant with escrow obligations."}, {"id": "docs_16_billing_and_entitlements_dunning", "label": "Dunning Ladder (7-day grace, honest copy)", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_16_billing_and_entitlements_refunds_proration", "label": "Refunds, Proration, Cancellation", "file_type": "concept", "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upgrades apply entitlements immediately because a paying customer should never wait; the downgrade screen shows exactly what will be blocked before confirming, and support credits are audited entitlement overrides rather than manual DB edits."}], "edges": [{"source": "docs_16_billing_and_entitlements_subscription_lifecycle", "target": "docs_16_billing_and_entitlements_soft_block_matrix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "weight": 1.0}, {"source": "docs_16_billing_and_entitlements_soft_block_matrix", "target": "docs_16_billing_and_entitlements_read_export_always_work", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "weight": 1.0}, {"source": "docs_16_billing_and_entitlements_razorpay_webhooks", "target": "docs_04_data_model_subscriptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "weight": 1.0}, {"source": "docs_16_billing_and_entitlements_razorpay_webhooks", "target": "docs_04_data_model_webhook_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "weight": 1.0}, {"source": "docs_16_billing_and_entitlements_entitlements_model", "target": "docs_04_data_model_entitlements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "weight": 1.0}, {"source": "docs_16_billing_and_entitlements_entitlements_model", "target": "docs_16_billing_and_entitlements_enforcement_points", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "weight": 1.0}, {"source": "docs_16_billing_and_entitlements_usage_metering", "target": "docs_04_data_model_usage_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "weight": 1.0}, {"source": "docs_16_billing_and_entitlements_gst_invoicing", "target": "docs_01_business_model_org_level_pricing", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/16-billing-and-entitlements.md", "source_location": null, "weight": 1.0}, {"source": "docs_16_billing_and_entitlements_byo_razorpay_collections", "target": "docs_04_data_model_project_payments", "relation": "references", "confidence": "EXTRACTED"