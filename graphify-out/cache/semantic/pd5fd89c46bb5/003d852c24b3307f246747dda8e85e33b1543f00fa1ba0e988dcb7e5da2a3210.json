{"nodes": [{"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_adr_0013", "label": "ADR-0013: Billing \u2014 Razorpay Subscriptions + in-house entitlements", "file_type": "document", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Launch is next month and a second billing source of truth is unaffordable, so one INR rail with native trial support wins; platform SaaS billing and tenant customer collections must never be confused, and keeping funds out of our hands avoids RBI Payment Aggregator regulation."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_razorpay_subscriptions", "label": "Razorpay Subscriptions (platform billing)", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_upi_autopay", "label": "UPI AutoPay mandate (primary rail)", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u20b915,000/debit cap comfortably fits tier prices at ~0.5% + GST fees."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_card_emandate", "label": "Card e-mandate fallback", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_trial_only_no_free_tier", "label": "Trial-only, no free tier", "file_type": "rationale", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "14-day full-feature trial with a single 7-day support extension, implemented by Razorpay's native trial support. A perpetual free tier breaks the capacity-tiered unit economics in docs/01."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_webhook_at_least_once", "label": "At-least-once webhook handling", "file_type": "rationale", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HMAC signature verify, dedupe on x-razorpay-event-id, fast-2xx plus queue, subscription.charged as the entitlement-granting event, API polling as reconciliation backstop."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_entitlements_postgres", "label": "In-house entitlements + usage on Postgres", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "plans, subscriptions, subscription_events, entitlements \u2014 a few days' work in NestJS versus a second source of truth; we own metering correctness."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_usage_events", "label": "usage_events append-only ledger", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voice minutes, AI detections, OTP and storage with period rollups; grant/expiry/rollup must be covered by the money-math invariants."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_soft_block_read_export", "label": "Soft-block enforcement; read + export always work", "file_type": "rationale", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Product law: never hold tenant data hostage to billing state."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_gst_supplier_of_record", "label": "GST supplier-of-record obligations", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Razorpay is a gateway, not merchant-of-record \u2014 GST-compliant invoices per cycle under our GSTIN/SAC, e-invoicing IRN validation ours, Razorpay's 18% GST on fees tracked separately."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_paymentlinkport", "label": "PaymentLinkPort \u2014 BYO-Razorpay per tenant", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each EPC connects its own Razorpay account and funds settle directly to the EPC; onboarding friction is accepted as the price of staying unregulated."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_no_pa_licence", "label": "Platform never touches funds (no RBI PA licence)", "file_type": "rationale", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregating collections would make us master merchant with KYC burden and drag us into Payment Aggregator territory."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_bullmq_queue", "label": "BullMQ webhook queueing", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_chargebee", "label": "Rejected: Chargebee", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u2248$7,188/yr, sits on top of Razorpay anyway, and adds a second source of truth for a single-currency launch."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_zoho_billing", "label": "Rejected: Zoho Billing", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheap and GST-native but weak on usage-based pricing and declining mindshare."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_stripe", "label": "Rejected: Stripe", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Still not a general domestic India acquirer in 2026; only wins for USD billing abroad."}, {"id": "docs_adr_0013_billing_razorpay_inhouse_entitlements_razorpay_route_default", "label": "Rejected: platform-aggregated collections (Razorpay Route / Easy Split as default)", "file_type": "concept", "source_file": "docs/adr/0013-billing-razorpay-inhouse-entitlements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept strictly as an alternate adapter \u2014 as a default it makes us master merchant and drags us toward PA regulation."}], "edges": [{"source": "docs_adr_0013_billing_razorpay_inhouse_entitlements_adr_0013", "target": "docs_adr_0013_billing_razorpay_inhouse_entitlements_razorpay_subscriptions", "relation": "references", "confidence": "EXTRACTED", "confidence