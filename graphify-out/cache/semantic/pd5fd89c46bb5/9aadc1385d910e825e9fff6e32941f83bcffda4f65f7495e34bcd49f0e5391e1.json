{"nodes": [{"id": "_claude_skills_contract_change_skill_contract_change_sequence", "label": "/contract-change \u2014 the contract change sequence", "file_type": "document", "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_contract_change_skill_reemit_openapi", "label": "Re-emit and commit the OpenAPI surface", "file_type": "rationale", "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The emit reads dist/, so build first or you emit the old surface from stale dist and see no diff for a change you did make. A stale committed surface is a lie told to every reader."}, {"id": "_claude_skills_contract_change_skill_check_openapi", "label": "pnpm check:openapi", "file_type": "concept", "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds, emits, fails on a stale committed spec, and with oasdiff installed also flags breaking changes against origin/main \u2014 advisory, not a CI gate."}, {"id": "_claude_skills_contract_change_skill_pgenum_in_step", "label": "Keep the pgEnum in step with the contract enum", "file_type": "rationale", "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A value on one side only is a silent production defect \u2014 rows the API can never return, or API values the database rejects at insert."}, {"id": "_claude_skills_contract_change_skill_sweep_typed_clients", "label": "Sweep the typed clients with turbo typecheck", "file_type": "rationale", "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A call site that did NOT break where you expected it to is hand-rolling HTTP; a Record map that did not break is not exhaustive."}, {"id": "_claude_skills_contract_change_skill_judge_breaking_changes", "label": "Judge breaking changes before shipping", "file_type": "rationale", "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing a field, tightening a type, renaming a key or changing a declared status code breaks every existing client; a genuine break needs an owner ruling stated in the change."}], "edges": [{"source": "_claude_skills_contract_change_skill_contract_change_sequence", "target": "_claude_rules_contracts_contract_diff_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_contract_change_skill_contract_change_sequence", "target": "_claude_skills_contract_change_skill_reemit_openapi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_contract_change_skill_contract_change_sequence", "target": "_claude_skills_contract_change_skill_pgenum_in_step", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_contract_change_skill_contract_change_sequence", "target": "_claude_skills_contract_change_skill_sweep_typed_clients", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/contract-change/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_cl