{"nodes": [{"id": "design_mockups_panellayout_dc_panel_layout_screen", "label": "Panel Layout (design steps 5-6)", "file_type": "document", "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The core 3D design surface: the designer places and tunes the array, safety objects and wiring to reach a valid, buildable layout. Panel and inverter come from step 4; the result feeds the BOM."}, {"id": "design_mockups_panellayout_dc_solar_access_heatmap", "label": "Solar access heatmap", "file_type": "concept", "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-month solar access rendered as a 0-100% gradient with sun-hours and kWh/m2, so panel placement is judged on measured access rather than eyeballing the roof."}, {"id": "design_mockups_panellayout_dc_shadow_simulation", "label": "Shadow / shading simulation", "file_type": "concept", "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array-and-shadows view at a chosen time of day. A proposal built from this design can label its generation numbers as derived rather than estimated."}, {"id": "design_mockups_panellayout_dc_design_health_score", "label": "Design health score and band", "file_type": "concept", "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_mockups_panellayout_dc_string_and_dc_cable_design", "label": "Strings and DC cable runs", "file_type": "concept", "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_mockups_panellayout_dc_auto_fill_vs_manual_placement", "label": "Auto-fill roof vs manual panel placement", "file_type": "rationale", "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two entry routes: place panels by hand, or fill the roof to the step 4 target or the roof maximum. Clearing everything is destructive but undoable, so the confirmation names exactly what disappears (panels, strings, cable runs)."}, {"id": "design_mockups_panellayout_dc_layout_lock", "label": "Layout lock", "file_type": "concept", "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "design_mockups_panellayout_dc_panel_layout_screen", "target": "design_mockups_panellayout_dc_solar_access_heatmap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_panellayout_dc_panel_layout_screen", "target": "design_mockups_panellayout_dc_shadow_simulation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_panellayout_dc_panel_layout_screen", "target": "design_mockups_panellayout_dc_design_health_score", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_panellayout_dc_panel_layout_screen", "target": "design_mockups_panellayout_dc_string_and_dc_cable_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/PanelLayout.dc.html", "source_location": null, "weight": 1.0}, {"source