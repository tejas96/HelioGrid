{"nodes": [{"id": "_claude_rules_db_schema_append_only_migrations", "label": "Migrations are append-only and sha256-locked", "file_type": "rationale", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editing an applied file makes the runner refuse to run at all; a PreToolUse hook also blocks the edit."}, {"id": "_claude_rules_db_schema_tenant_table_four_requirements", "label": "Every tenant-owned table needs all four (tenant_id, composite index, RLS policy, grants)", "file_type": "concept", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There are no default privileges, so a forgotten grant fails closed rather than leaking."}, {"id": "_claude_rules_db_schema_tenancy_defence_in_depth", "label": "Tenancy defence in depth \u2014 guard, repository filter, RLS backstop", "file_type": "concept", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All three always: JWT claims, tenantId from context never client input, RLS via current_setting('app.tenant_id', true) fail-closed."}, {"id": "_claude_rules_db_schema_cross_tenant_404", "label": "Cross-tenant reads return 404, never 403", "file_type": "rationale", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 403 reveals that another tenant's row exists."}, {"id": "_claude_rules_db_schema_uuidv7_app_side_ids", "label": "UUIDv7 ids generated app-side", "file_type": "rationale", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tables carry no DB-side id default, so raw SQL inserts must supply ids."}, {"id": "_claude_rules_db_schema_append_only_ledgers", "label": "Append-only ledgers (audit_log, usage_events, sync_mutations)", "file_type": "concept", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They get no UPDATE or DELETE grants at all."}, {"id": "_claude_rules_db_schema_enum_parity_invariant", "label": "enum-parity invariant (live pg_enum vs contract schemas)", "file_type": "concept", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks both directions plus NO_CONTRACT_YET mapping; it is what stops one side moving alone now that db-no-upward blocks the import."}, {"id": "_claude_rules_db_schema_global_tables_scan", "label": "GLOBAL_TABLES / table-tenancy-scan", "file_type": "concept", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A table is either tenant-scoped or listed global with its reason \u2014 there is no third option, and the scan fails on anything else."}, {"id": "_claude_rules_db_schema_module_wise_growth", "label": "Schema grows module-wise only", "file_type": "rationale", "source_file": ".claude/rules/db-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_rules_contracts_pgenum_hand_mirror", "target": "_claude_rules_db_schema_enum_parity_invariant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/db-schema.md", "source_location": null, "weight": 1.0}, {"source": "_claude_rules_db_schema_append_only_migrations", "target": "_claude_skills_migration_skill_migration_sequence", "relation": "references", "confidence": "EXTRACTED", "co