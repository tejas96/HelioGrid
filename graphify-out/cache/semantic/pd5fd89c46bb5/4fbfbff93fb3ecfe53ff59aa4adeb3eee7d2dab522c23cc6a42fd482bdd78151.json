ent."}, {"id": "docs_13_ux_gap_register_uxg_par_01", "label": "UXG-PAR-01 \u2014 RN cleared only part of the OTP error state (CLOSED)", "file_type": "concept", "source_file": "docs/13-ux-gap-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original finding was wrong and the correction matters more: RN did surface the failed resend, via a separate boolean rather than the shared union. The real divergence was narrower \u2014 web's single union cleared all three failures on edit while RN cleared one."}], "edges": [{"source": "docs_13_ux_gap_register_register_rules", "target": "docs_10_i18n_and_design_system_definition_of_done", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/13-ux-gap-register.md", "source_location": null, "weight": 1.0}, {"source": "docs_13_ux_gap_register_register_rules", "target": "docs_10_i18n_and_design_system_n1_n10", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/13-ux-gap-register.md", "source_location": null, "weight": 1.0}, {"source": "docs_13_ux_gap_register_uxg_05", "target": "docs_14_build_roadmap_track_a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/13-ux-gap-register.md", "source_location": null, "weight": 1.0}, {"source": "docs_13_ux_gap_register_uxg_05", "target": "docs_04_data_model_customers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/13-ux-gap-register.md", "source_location": null, "weight": 1.0}, {"source": "docs_13_ux_gap_register_uxg_06", "target": "docs_04_data_model_engineer_signoffs", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/13-ux-gap-register.md", "source_location": null, "weight": 1.0}, {"source": "docs_13_ux_gap_register_uxg_10", "target": "docs_06_offline_and_sync_sta