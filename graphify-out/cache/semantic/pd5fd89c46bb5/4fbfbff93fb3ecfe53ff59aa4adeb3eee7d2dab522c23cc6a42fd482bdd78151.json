{"nodes": [{"id": "docs_13_ux_gap_register_register_rules", "label": "UX Gap Register Rules (claim, close, never delete rows)", "file_type": "concept", "source_file": "docs/13-ux-gap-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each gap is designed at implementation time directly in the design system inside the module's build slice \u2014 there is no separate design phase, and the file is the single ledger so closed rows stay visible."}, {"id": "docs_13_ux_gap_register_uxg_05", "label": "UXG-05 \u2014 Merge-customer flow", "file_type": "concept", "source_file": "docs/13-ux-gap-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_13_ux_gap_register_uxg_06", "label": "UXG-06 \u2014 Engineer sign-off queue", "file_type": "concept", "source_file": "docs/13-ux-gap-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_13_ux_gap_register_uxg_10", "label": "UXG-10 \u2014 Offline/sync status system", "file_type": "concept", "source_file": "docs/13-ux-gap-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_13_ux_gap_register_uxg_11", "label": "UXG-11 \u2014 Named links + OTP-at-accept", "file_type": "concept", "source_file": "docs/13-ux-gap-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A \u20b992L C&I acceptance by 'whoever holds the URL' is the sharpest liability in the product, so the token scheme had to support named links from day one."}, {"id": "docs_13_ux_gap_register_uxg_13", "label": "UXG-13 \u2014 Real billing suite (supersedes the D26-era mock)", "file_type": "concept", "source_file": "docs/13-ux-gap-register.md", "source_location": null, "source_url": null, "captured_