{"nodes": [{"id": "docs_06_offline_and_sync_principles", "label": "Offline Principles (reads local, writes queued, server owns money)", "file_type": "rationale", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One mental model on mobile and web so AI agents implement one write path, not three; offline output is always labelled provisional because the server owns truth and money."}, {"id": "docs_06_offline_and_sync_powersync_deployment", "label": "PowerSync Deployment on Fly bom", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated publication over synced tables only keeps WAL fan-out and bucket churn bounded; buckets live in their own database so vacuum churn never bloats the app DB."}, {"id": "docs_06_offline_and_sync_sync_streams", "label": "Sync Streams (token-parameterised, server-enforced scoping)", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stream parameters come from the verified JWT so the client cannot widen scope; even role-widening for managers is token-derived, never a client-supplied filter."}, {"id": "docs_06_offline_and_sync_backend_connector", "label": "NestJS Backend Connector (the write path is our code)", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every response including rejects acks the mutation so the client can drop it and let sync-down restore server truth; 5xx is reserved for genuine faults, never business rejection."}, {"id": "docs_06_offline_and_sync_mutation_envelope", "label": "MutationEnvelope (mutation_id, entity, op, base_version)", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_06_offline_and_sync_conflict_matrix", "label": "Conflict Matrix (versioned-append, LWW, 409 on design)", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LWW is resolved by server apply order, never device clocks; captured_at is preserved for display and audit only."}, {"id": "docs_06_offline_and_sync_attachment_pipeline", "label": "Attachment Pipeline (capture \u2192 presign \u2192 upload \u2192 ack-then-prune)", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The full-resolution local copy is deleted only after the survey_photos row syncs back down \u2014 proof the server owns it; never base64 through the stream, never pruning before ack."}, {"id": "docs_06_offline_and_sync_not_offline", "label": "What Is NOT Offline (money math, design editing on mobile)", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No device ever prints a customer-facing price computed locally; entitlement state is cached with a 72h grace so a paid tenant is never soft-blocked by a dead zone."}, {"id": "docs_06_offline_and_sync_status_ux_contract", "label": "Sync Status UX Contract (never blocking)", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_06_offline_and_sync_failure_modes", "label": "Failure Modes & Recovery (quarantine, slot loss, token expiry)", "file_type": "concept", "source_file": "docs/06-offline-and-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quarantine, never crash, never silently drop \u2014 nothing a field user captured is ever unrecoverable; a different user signing in wipes the local DB first because tenant isolation beats convenience."}], "edges": [{"source": "docs_06_offline_and_sync_principles", "target": "docs_06_offline_and_sync_backend_connector", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/06-offline-and-sync.md", "source_location": null, "weight": 1.0}, {"source": "docs_06_offline_and_sync_powersync_deployment", "target": "docs_06_offline_and_sync_sync_streams", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/06-offline-and-sync.md", "source_location": null, "weight": 1.0}, {"source": "docs_06_offline_and_sync_sync_streams", "target": "docs_08_security_and_tenancy_session_models", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/06-offline-and-sync.md", "source_location": null, "weight": 1.0}, {"source": "docs_06_offline_and_sync_backend_connector", "target": "docs_06_offline_and_sync_mutation_envelope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/06-offline-and-sync.md", "source_location": null, "weight": 1.0}, {"source": "docs_06_offline_and_sync_mutation_envelope", "target": "docs_04_data_model_sync_mutations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/06-offline-and-sync.md", "source_location": null, "weight": 1.0}, {"source": "docs_06_offline_and_sync_backend_connector", "target": "docs_08_security_and_tenancy_rls_backstop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou