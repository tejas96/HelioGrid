{"nodes": [{"id": "docs_00_vision_and_scope_heliogrid", "label": "HelioGrid (multi-tenant SaaS for Indian solar EPCs)", "file_type": "concept", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most Indian EPCs run on Excel and WhatsApp; PM Surya Ghar creates an enormous under-digitised funnel, so one record that travels from lead to payment replaces the spreadsheet-and-rekeying pipeline."}, {"id": "docs_00_vision_and_scope_nine_stage_journey", "label": "The Nine-Stage Journey (v1 backbone)", "file_type": "concept", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_00_vision_and_scope_3d_design_studio", "label": "3D Design Studio (the flagship)", "file_type": "concept", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is compromised against the studio: it is the engineering moat, so every tool and computed output must survive the port at full parity including 375px mobile."}, {"id": "docs_00_vision_and_scope_honesty_is_a_feature", "label": "Honesty Is a Feature", "file_type": "rationale", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Competitors sell certainty; HelioGrid sells trustworthy numbers \u2014 hence provenance tiers on every figure, money never rendering while stale, and structural adequacy never computed."}, {"id": "docs_00_vision_and_scope_india_first_global_ready", "label": "India-First, Global-Ready", "file_type": "rationale", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GST, subsidy slabs, DISCOM states and TRAI calling rules are injected market configuration rather than hard-coded, so a new market is configuration and not a rewrite."}, {"id": "docs_00_vision_and_scope_explicit_non_goals", "label": "Explicit Non-Goals (v1)", "file_type": "concept", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named so nobody 'helpfully' builds them: inventory/PO/O&M, WhatsApp sending, custom roles, LiDAR measurement, discount approvals, feature flags, PPA billing, website/inbound-WhatsApp channels."}, {"id": "docs_00_vision_and_scope_three_audiences", "label": "The Three Audiences (owner, employees, EPC's customer)", "file_type": "concept", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_00_vision_and_scope_pm_surya_ghar", "label": "PM Surya Ghar subsidy programme", "file_type": "concept", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_00_vision_and_scope_customer_journey_c1_c13", "label": "Parallel Customer Journey C1\u2013C13 (no login)", "file_type": "concept", "source_file": "docs/00-vision-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_00_vision_and_scope_heliogrid", "target": "docs_00_vision_and_scope_nine_stage_journey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/00-vision-and-scope.md", "source_location": null, "weight": 1.0}, {"source": "docs_00_vision_and_scope_heliogrid", "target": "docs_00_vision_and_scope_3d_design_studio", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/00-vision-and-scope.md", "so