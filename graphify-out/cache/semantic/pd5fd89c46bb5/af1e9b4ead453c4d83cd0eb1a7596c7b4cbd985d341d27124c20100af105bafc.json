{"nodes": [{"id": "docs_adr_0018_fly_one_app_per_service_adr_0018", "label": "ADR-0018: Fly topology \u2014 one app per service", "file_type": "document", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fly process groups share one Docker image per app, but powersync runs a prebuilt third-party image while web/api/worker/voice each need a different build \u2014 the earlier single-app process-group wording was unimplementable as written."}, {"id": "docs_adr_0018_fly_one_app_per_service_one_app_per_service", "label": "One Fly app per service", "file_type": "concept", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "heliogrid-web, -api, -worker, -voice, -powersync plus the postgres-flex cluster app and log-shipper; 5 fly.toml files instead of one, bought with per-app deploys, rollbacks, scaling and autostop policy."}, {"id": "docs_adr_0018_fly_one_app_per_service_heliogrid_powersync_app", "label": "heliogrid-powersync (prebuilt journeyapps image, digest-pinned)", "file_type": "concept", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A third-party image cannot be a process group inside an app that also builds our own images \u2014 this is the concrete fact that forced the topology."}, {"id": "docs_adr_0018_fly_one_app_per_service_per_app_dockerfiles", "label": "Per-app Dockerfiles", "file_type": "concept", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Different entrypoints, and the worker image additionally carries Chromium plus Noto Sans Devanagari fonts for PDF rendering."}, {"id": "docs_adr_0018_fly_one_app_per_service_6pn_private_networking", "label": "6PN .internal / flycast private networking", "file_type": "concept", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only web and api are exposed through Fly's proxy (webhooks plus mobile); everything else stays private."}, {"id": "docs_adr_0018_fly_one_app_per_service_per_app_secrets_blast_radius", "label": "Per-app secrets and deploy blast radius", "file_type": "rationale", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secrets staged per app is more setup but a smaller blast radius per rotation; a worker deploy cannot break web."}, {"id": "docs_adr_0018_fly_one_app_per_service_single_app_process_groups", "label": "Rejected: single-app process groups", "file_type": "concept", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unimplementable \u2014 all process groups share one image."}, {"id": "docs_adr_0018_fly_one_app_per_service_fewer_combined_apps", "label": "Rejected: fewer combined apps (web+api together)", "file_type": "concept", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Couples scaling, autostop policy and deploy blast radius for no operational saving."}, {"id": "docs_02_system_architecture_system_architecture", "label": "docs/02 \u2014 system architecture", "file_type": "document", "source_file": "docs/adr/0018-fly-one-app-per-service.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"sou