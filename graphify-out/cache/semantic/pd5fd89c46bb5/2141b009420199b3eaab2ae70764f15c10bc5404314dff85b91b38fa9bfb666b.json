{"nodes": [{"id": "design_mockups_proposalentry_dc_proposal_entry_screen", "label": "Proposal builder entry", "file_type": "document", "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Who is this for?' appears only when the builder starts from the Proposals list; started from a lead the customer is already known and that step is skipped."}, {"id": "design_mockups_proposalentry_dc_eleven_step_shell", "label": "11-step proposal builder shell", "file_type": "concept", "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps can be done in any order. Next never blocks; only Generate validates and jumps to the first problem, so a rep is never trapped on a step they cannot finish yet."}, {"id": "design_mockups_proposalentry_dc_starting_point_routes", "label": "Three starting points (with design / without design / duplicate)", "file_type": "rationale", "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With a design is recommended because size, generation, savings and components fill from it. Without a design is faster but the numbers stay estimates until a survey confirms them. Duplicating a past proposal is the fastest route for repeat residential jobs."}, {"id": "design_mockups_proposalentry_dc_customer_search", "label": "Customer search across leads and customers", "file_type": "concept", "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A no-match result offers 'start as new customer' and auto-creates the lead from the client details entered in step 10, so a stranger never blocks the quote."}, {"id": "design_mockups_proposalentry_dc_save_on_blur", "label": "Save on blur", "file_type": "concept", "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_mockups_proposalentry_dc_resumable_draft", "label": "Resumable draft (step N of 11) on the lead", "file_type": "concept", "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_mockups_proposalentry_dc_generate_validation_gate", "label": "Generate is the only validation gate", "file_type": "rationale", "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validation is deferred to one place. Per-step state (done / needs fixing / here) is surfaced on the rail so the rep can see the outstanding problems without being stopped by them."}], "edges": [{"source": "design_mockups_proposalentry_dc_proposal_entry_screen", "target": "design_mockups_proposalentry_dc_eleven_step_shell", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_proposalentry_dc_proposal_entry_screen", "target": "design_mockups_proposalentry_dc_starting_point_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_proposalentry_dc_proposal_entry_screen", "target": "design_mockups_proposalentry_dc_customer_search", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/ProposalEntry.dc.html", "source_location": null, "weight": 1.0}, {"source": 