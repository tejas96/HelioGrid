{"nodes": [{"id": "docs_adr_0012_voice_exotel_sarvam_adr_0012", "label": "ADR-0012: Voice agent \u2014 Exotel + Sarvam behind a thin orchestrator", "file_type": "document", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buy the two things we must never build in India (UL-VNO carrier licensing with DLT operations, Indic STT/TTS) and own the thin glue. Indian telecom law (TRAI/DLT, DND, 1600 vs 140x, CLI rules) plus DPDP residency rule out US-hosted voice stacks; the moat-bearing code is the orchestrator, so it stays ours and vendor-neutral."}, {"id": "docs_adr_0012_voice_exotel_sarvam_exotel", "label": "Exotel (TelephonyProvider)", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UL-VNO-licensed carrier with the strongest DLT operations, AgentStream bidirectional WebSocket, IVR applets and DTMF."}, {"id": "docs_adr_0012_voice_exotel_sarvam_sarvam_ai", "label": "Sarvam AI (SpeechProvider + LanguageModel)", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sovereign India compute keeps audio, transcripts and PII off US infrastructure; best-in-class Indic speech quality."}, {"id": "docs_adr_0012_voice_exotel_sarvam_saarika_stt", "label": "Saarika STT", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowest WER in 13 of 15 Indian languages."}, {"id": "docs_adr_0012_voice_exotel_sarvam_bulbul_tts", "label": "Bulbul TTS", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beats ElevenLabs on Hindi prosody."}, {"id": "docs_adr_0012_voice_exotel_sarvam_apps_voice", "label": "apps/voice (NestJS standalone)", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0012_voice_exotel_sarvam_callsession", "label": "CallSession orchestrator", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turn-taking, barge-in, AI disclosure within 30s, escalate-to-human and outcome classification are never vendor-specific \u2014 this is the glue we own."}, {"id": "docs_adr_0012_voice_exotel_sarvam_compliancegate", "label": "ComplianceGate (non-swappable, ours)", "file_type": "rationale", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily DND scrub, consent, 9am\u20139pm window and holiday calendar, 1600 vs 140x routing, keypress opt-out within 24h, 90-day recording retention. The \u20b925,000-per-complaint penalty lands on the tenant as Principal Entity, so the gate must live in our code, not a vendor's."}, {"id": "docs_adr_0012_voice_exotel_sarvam_telephonyprovider", "label": "TelephonyProvider port", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0012_voice_exotel_sarvam_speechprovider", "label": "SpeechProvider port", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0012_voice_exotel_sarvam_languagemodel", "label": "LanguageModel port", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0012_voice_exotel_sarvam_usage_ledger", "label": "Per-tenant voice usage metering", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every leg \u2014 telephony seconds, STT minutes, TTS chars, LLM tokens \u2014 is metered per tenant into the usage ledger; cost \u2248 \u20b92.5\u20134/min outbound all-in."}, {"id": "docs_adr_0012_voice_exotel_sarvam_tenant_phone_numbers", "label": "tenant_phone_numbers (per-tenant numbers, BYO)", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default platform Exophone; BYO via hosting/porting with KYC. TRAI CLI rules mean this is never caller-ID spoofing."}, {"id": "docs_adr_0012_voice_exotel_sarvam_ivr_both_directions", "label": "IVR in both directions", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inbound per-tenant flow builder (greeting \u2192 menu \u2192 AI / human / voicemail, business-hours aware); outbound DTMF traversal via sendDtmf/onDtmf with STT prompt detection."}, {"id": "docs_adr_0012_voice_exotel_sarvam_bolna", "label": "Bolna (documented Plan B)", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strong India-native all-in-one (~\u20b96/min) but inheriting their agent runtime costs coarser cost/persona control \u2014 kept behind the same ports as Plan B rather than primary."}, {"id": "docs_adr_0012_voice_exotel_sarvam_livekit", "label": "LiveKit self-host (v2 reference target)", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best long-term, but owning SIP trunking, DLT wiring and turn-taking tuning pre-launch is unaffordable; the port layer is designed toward it and it is deferred to v2."}, {"id": "docs_adr_0012_voice_exotel_sarvam_dpdp_residency", "label": "DPDP residency constraint on voice data", "file_type": "rationale", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voice audio, transcripts and PII must not transit US infrastructure \u2014 this single constraint eliminates the entire US voice-agent vendor category."}, {"id": "docs_adr_0012_voice_exotel_sarvam_vapi_retell_bland", "label": "Rejected: Vapi / Retell / Bland", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio transits US infra so DPDP residency fails; DLT support is bolt-on or absent and \u20b9-cost is no better."}, {"id": "docs_adr_0012_voice_exotel_sarvam_sarvam_samvaad", "label": "Rejected: Sarvam Samvaad managed runtime", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sovereign and capable but launched early 2026 with unproven telephony/DLT maturity; buying the runtime dissolves the swap boundary."}, {"id": "docs_adr_0012_voice_exotel_sarvam_pipecat", "label": "Rejected: Pipecat", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python \u2014 breaks the TypeScript-everywhere rule."}, {"id": "docs_adr_0012_voice_exotel_sarvam_twilio_plivo_knowlarity_ozonetel", "label": "Rejected: Twilio / Plivo / Knowlarity / Ozonetel", "file_type": "concept", "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cost, thin India DLT tooling, or weak streaming APIs respectively."}], "edges": [{"source": "docs_adr_0012_voice_exotel_sarvam_adr_0012", "target": "docs_adr_0012_voice_exotel_sarvam_exotel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0012_voice_exotel_sarvam_adr_0012", "target": "docs_adr_0012_voice_exotel_sarvam_sarvam_ai", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0012_voice_exotel_sarvam_sarvam_ai", "target": "docs_adr_0012_voice_exotel_sarvam_saarika_stt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0012_voice_exotel_sarvam_sarvam_ai", "target": "docs_adr_0012_voice_exotel_sarvam_bulbul_tts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0012-voice-exotel-sarvam.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0012_voice_exotel_sarvam_exotel", "target": "docs_adr_0012_voice_exotel_sarvam_telephonyprovider", "relation": "implements", "confidence": "EXTRACTED", 