{"nodes": [{"id": "docs_01_business_model_org_level_pricing", "label": "Org-Level Capacity-Tiered Pricing", "file_type": "concept", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-seat pricing punishes whole-company adoption, which is exactly the behaviour the single-record pipeline needs; incumbents already price per-org or per-capacity, so HelioGrid adopts the same axis and undercuts every rung."}, {"id": "docs_01_business_model_trial_only_no_free_tier", "label": "Trial-Only, No Free Tier", "file_type": "rationale", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenSolar's free product is funded by distributor placement and a payments cut \u2014 a transaction-layer business deliberately not entered; without that engine a free tier is pure metered COGS."}, {"id": "docs_01_business_model_soft_block_cap_enforcement", "label": "Soft-Block Cap Enforcement", "file_type": "concept", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caps are upgrade signals and abuse bounds, never feature ransoms \u2014 reading, editing existing records and exporting never pause."}, {"id": "docs_01_business_model_metered_cogs", "label": "Metered COGS (voice minutes, AI detections, OTP)", "file_type": "concept", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_business_model_unit_economics", "label": "Unit Economics \u2014 gross margin \u226580% at typical utilisation", "file_type": "concept", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worst-case floors are accepted because the dominant small-tier cost is amortised fixed infra that falls with tenant density, and overage sits \u226540% above worst-case unit COGS so no tier can go margin-negative."}, {"id": "docs_01_business_model_pricing_principles", "label": "Pricing Principles (binding)", "file_type": "rationale", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_business_model_go_to_market", "label": "Go-To-Market (ride PM Surya Ghar, replace Excel+WhatsApp)", "file_type": "concept", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_business_model_reslink", "label": "Reslink Energy (India pricing benchmark)", "file_type": "concept", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_business_model_arka_360", "label": "ARKA 360 (competitor)", "file_type": "concept", "source_file": "docs/01-business-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_01_business_model_org_level_pricing", "target": "docs_16_billing_and_entitlements_subscription_lifecycle", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-business-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_business_model_trial_only_no_free_tier", "target": "docs_16_billing_and_entitlements_subscription_lifecycle", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/01-business-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_business_model_soft_block_cap_enforcement", "target": "docs_16_billing_and_entitlements_so