{"nodes": [{"id": "docs_14_build_roadmap_scope_commitment", "label": "Scope Commitment (no Launch-2, no v1.1, no 'later' bucket)", "file_type": "rationale", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The document was made DATELESS because reality invalidated the 20-day calendar and day numbers were being read as commitments they could no longer support; what governs is the track dependency structure, the launch gate and the risk register."}, {"id": "docs_14_build_roadmap_track_f", "label": "Track F \u2014 Foundations + all external paperwork filed", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_14_build_roadmap_track_a", "label": "Track A \u2014 identity & money core", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_14_build_roadmap_track_b", "label": "Track B \u2014 the money path & customer surface", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_14_build_roadmap_track_c", "label": "Track C \u2014 voice agent + awareness surfaces", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_14_build_roadmap_track_m", "label": "Track M \u2014 mobile in lockstep with web (not a phase)", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A module with a mobile surface is not done until both its web and RN screens ship in the same slice from the same contract \u2014 mobile is never a follow-up task."}, {"id": "docs_14_build_roadmap_track_d", "label": "Track D \u2014 THE STUDIO PORT (flagship, last by priority)", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The census gate is a QUALITY gate and does not move for the calendar: if the track nears its end with census rows open, the release valve is dashboards and polish scope elsewhere, never census rows."}, {"id": "docs_14_build_roadmap_track_e", "label": "Track E \u2014 offline layer + hardening + launch gate", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Last track because nothing at launch depends on offline; until it lands, mobile is online-first behind repository interfaces so the swap is a data-layer change only."}, {"id": "docs_14_build_roadmap_launch_gate", "label": "LAUNCH GATE (all or no launch \u2014 8 conditions)", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_14_build_roadmap_risk_register", "label": "Risk Register (with named release valves)", "file_type": "concept", "source_file": "docs/14-build-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only release valves are dashboard polish, funnel analytics depth and agent-performance screens \u2014 never money invariants, tenancy isolation, census rows, offline round-trip or provenance surfaces."}, {"id": "docs_14_build_roadmap_external_clocks", "label": "Third-Party Approval Clocks (DLT, Exotel KYC, Razorpay, store review)", "file_type": "concept", "source_fil