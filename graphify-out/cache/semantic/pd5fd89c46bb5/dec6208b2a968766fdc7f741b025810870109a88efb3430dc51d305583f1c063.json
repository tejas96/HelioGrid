{"nodes": [{"id": "docs_08_security_and_tenancy_threat_model", "label": "Threat Model T1\u2013T8", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranked by impact \u00d7 likelihood for a multi-tenant Indian EPC SaaS holding phone PII, deal values to \u20b992L+ and BYO payment credentials; nation-state actors and DDoS beyond Fly/Upstash limits are explicit non-threats for v1."}, {"id": "docs_08_security_and_tenancy_phone_otp_flow", "label": "Phone-OTP authentication flow (one server flow, web and RN)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_08_security_and_tenancy_session_models", "label": "Session Models (cookie, keychain bearer, 10-min JWT)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sessions are server-side rows so deactivating a user kills every device inside one JWT TTL; the JWT claim set is the entire authz payload and nothing more."}, {"id": "docs_08_security_and_tenancy_capability_matrix", "label": "Six-Role Capability Matrix (16 capabilities)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OR across roles, visibility is widest, no per-user exceptions ever \u2014 exceptions are how permission systems become unauditable; deactivate never delete so history keeps attribution."}, {"id": "docs_08_security_and_tenancy_three_layer_defence", "label": "Three-Layer Tenancy Defence (guard \u2192 repo \u2192 RLS)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No layer trusts the one above it: a bug in the repository layer becomes an empty result rather than a leak."}, {"id": "docs_08_security_and_tenancy_rls_backstop", "label": "Postgres RLS backstop (FORCE RLS, NOBYPASSRLS boot assertion)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS silently no-ops for superusers and BYPASSRLS roles, and a table owner otherwise bypasses its own policies \u2014 hence FORCE ROW LEVEL SECURITY, a separate migrator role, and a startup assertion that refuses to boot."}, {"id": "docs_08_security_and_tenancy_customer_link_token", "label": "Customer-Link HMAC Token (stateless validity, stateful authority)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verification recomputes the MAC and checks exp, then loads the link row for revocation status \u2014 so a revoked link dies instantly regardless of exp; Accept is never trusted from the token alone."}, {"id": "docs_08_security_and_tenancy_otp_anti_abuse", "label": "OTP Anti-Abuse Controls", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All limits live in Upstash on the fixed plan with eviction OFF \u2014 a rate-limit key must never be evicted into an allow."}, {"id": "docs_08_security_and_tenancy_secrets_management", "label": "Secrets Management (Fly secrets + per-tenant DEK envelope)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-tenant credentials are AES-256-GCM encrypted with a DEK wrapped by a master key that exists only as a Fly secret on the app that must decrypt; decrypt in memory at the call site, never logged, never returned by any API, every decrypt audited."}, {"id": "docs_08_security_and_tenancy_dpdp_posture", "label": "DPDP Compliance Posture", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fiduciary for tenant users' PII, processor for the EPC's customer data; erasure is anonymisation rather than row deletion because financial and tax records must be retained for statutory periods."}, {"id": "docs_08_security_and_tenancy_audit_log_coverage", "label": "Audit Log Coverage Checklist (11 event classes)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_08_security_and_tenancy_supply_chain", "label": "Supply Chain Controls (frozen lockfile, postinstall disabled)", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dependency-cruiser boundaries double as anti-exfiltration: packages/domain cannot import network or storage modules, so a compromised transitive dep in domain code has no I/O path."}, {"id": "docs_08_security_and_tenancy_owasp_mapping", "label": "OWASP Top-10 Mapping", "file_type": "concept", "source_file": "docs/08-security-and-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_08_security_and_tenancy_threat_model", "target": "docs_08_security_and_tenancy_three_layer_defence", "relation": "rationale_for", "confidence": "EXTRACTED", "co