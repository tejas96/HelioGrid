{"nodes": [{"id": "_claude_rules_00_laws_law1_foundation_before_features", "label": "Law 1 \u2014 Foundation before features", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_rules_00_laws_law2_architecture_is_fixed", "label": "Law 2 \u2014 Architecture is fixed; features extend, never redefine", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new pattern needs an ADR approved before code, so architecture cannot drift one feature at a time."}, {"id": "_claude_rules_00_laws_law3_contracts_before_code", "label": "Law 3 \u2014 Contracts before code", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed order requirements -> domain model -> API contract -> shared types -> migration -> implementation -> verification -> docs; the contract diff IS the API review surface."}, {"id": "_claude_rules_00_laws_law4_single_source_of_truth", "label": "Law 4 \u2014 Single source of truth", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicate definitions are defects, not conveniences: enums to contracts, visual values to generated tokens, schema to docs/04 + migrations, copy to the one i18n catalog."}, {"id": "_claude_rules_00_laws_law5_reuse_before_creation", "label": "Law 5 \u2014 Reuse before creation", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_rules_00_laws_law6_requirement_traceability", "label": "Law 6 \u2014 Requirement traceability", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_rules_00_laws_law7_cross_platform_lockstep", "label": "Law 7 \u2014 Cross-platform lockstep (web + RN same change)", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both platforms ship from the same contract in the same change; exceptions require an owner ruling recorded where the decision was made."}, {"id": "_claude_rules_00_laws_law8_documentation_is_code", "label": "Law 8 \u2014 Documentation is code", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_rules_00_laws_law9_incremental_schema_growth", "label": "Law 9 \u2014 Incremental schema & API growth", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "docs/04 is frozen DESIGN, not a build order; a table belonging to a module that has not started is a violation."}, {"id": "_claude_rules_00_laws_decision_hierarchy", "label": "Decision hierarchy and tiebreakers", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-package CLAUDE.md beats a cross-cutting rule because it is closer to the code; a dated ADR beats a doc."}, {"id": "_claude_rules_00_laws_stop_and_ask_triggers", "label": "Stop-and-ask triggers", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Silently choosing between readings of an ambiguous spec is the failure the triggers exist to prevent; never invent a requirement."}, {"id": "_claude_rules_00_laws_minimise_blast_radius", "label": "Minimise blast radius", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If something small needs edits across many unrelated files, the architecture is wrong."}, {"id": "_claude_rules_00_laws_no_temporary_code", "label": "No temporary code", "file_type": "rationale", "source_file": ".claude/rules/00-laws.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_rules_00_laws_decision_hierarchy", "target": "apps_api_claude_nestjs_modular_monolith", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/00-laws.md", "source_location": null, "weight": 1.0}, {"source": "_claude_rules_00_laws_law2_architecture_is_fixed", "target": "_claude_rules_00_laws_stop_and_ask_triggers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/00-laws.md", "source_location": null, "weight": 1.0}, {"source": "_claude_rules_00_laws_law9_incremental_schema_growth", "target": "_claude_rules_00_laws_stop_and_ask_triggers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/00-laws.md", "source_location": null, "weight": 1.0}, {"source": "_claude_rules_00_laws_minimise_blast_radius", "target": "_claude_skills_qa_skill_blast_radius_from_diff", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": ".claude/rules/00-laws.md", "source_location": null, "weight": 1.0}, {"source": "_claude_rules_00_laws_stop_and_ask_trigg