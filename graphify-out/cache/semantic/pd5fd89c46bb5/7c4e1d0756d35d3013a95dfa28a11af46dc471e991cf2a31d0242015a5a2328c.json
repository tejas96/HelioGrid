{"nodes": [{"id": "design_mockups_proposalshare_dc_share_and_track_screen", "label": "Proposal share and track", "file_type": "document", "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_mockups_proposalshare_dc_rep_sends_not_app", "label": "The rep sends, the app does not", "file_type": "rationale", "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HelioGrid never sends the proposal - the rep shares from their own WhatsApp. The app supplies the PDF, the link and an editable suggested message saved as a template."}, {"id": "design_mockups_proposalshare_dc_mark_as_shared", "label": "Mark as shared starts the clock", "file_type": "concept", "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because the app cannot see the rep's WhatsApp, the rep declares it sent; that declaration starts the clock and creates a follow-up in two days."}, {"id": "design_mockups_proposalshare_dc_link_open_tracking", "label": "Link-open tracking with no 'delivered' state", "file_type": "rationale", "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only observable fact is whether the link was opened, so no delivery state is invented."}, {"id": "design_mockups_proposalshare_dc_voice_agent_followup", "label": "Voice agent follow-up call", "file_type": "concept", "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No link open within three days triggers an automated call to check the customer received it."}], "edges": [{"source": "design_mockups_proposalshare_dc_share_and_track_screen", "target": "design_mockups_proposalshare_dc_rep_sends_not_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_proposalshare_dc_share_and_track_screen", "target": "design_mockups_proposalshare_dc_mark_as_shared", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_proposalshare_dc_share_and_track_screen", "target": "design_mockups_proposalshare_dc_link_open_tracking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_proposalshare_dc_mark_as_shared", "target": "design_mockups_proposalshare_dc_voice_agent_followup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_proposalshare_dc_rep_sends_not_app", "target": "design_mockups_project_flow_dc_handover", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_proposalshare_dc_share_and_track_screen", "target": "design_mockups_proposalversions_dc_proposal_versions_screen", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design/mockups/ProposalShare.dc.html", "source_location": null, "weight": 1.0}, {"source": "design_mockups_proposalshare_dc_share_and_track_screen", "target": "design_mockups_project_flow_dc_mark_won", 