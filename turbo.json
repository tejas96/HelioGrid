{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", "**/*.tsbuildinfo", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "DATABASE_ADMIN_URL", "CI"],
      "cache": false
    },
    "//#lint": {
      "cache": false
    },
    "lint": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "openapi": {
      "dependsOn": ["build"],
      "outputs": ["openapi/**"]
    }
  },
  "boundaries": {
    "tags": {
      "domain": {
        "dependencies": {
          "allow": ["domain", "config"]
        }
      },
      "contracts": {
        "dependencies": {
          "allow": ["contracts", "domain", "config"]
        }
      },
      "data": {
        "dependencies": {
          "allow": ["data", "contracts", "domain", "config"]
        }
      },
      "db": {
        "dependencies": {
          "allow": ["db", "domain", "config"]
        }
      },
      "tokens": {
        "dependencies": {
          "allow": ["tokens", "config"]
        }
      },
      "i18n": {
        "dependencies": {
          "allow": ["i18n", "contracts", "domain", "config"]
        }
      },
      "ui": {
        "dependencies": {
          "allow": ["ui", "ui-api", "contracts", "domain", "tokens", "config"]
        }
      },
      "ui-api": {
        "dependencies": {
          "allow": ["contracts", "config"]
        }
      },
      "forms": {
        "dependencies": {
          "allow": ["forms", "config"]
        }
      },
      "app": {
        "dependencies": {
          "allow": [
            "app",
            "contracts",
            "data",
            "domain",
            "db",
            "tokens",
            "ui",
            "ui-api",
            "i18n",
            "forms",
            "adapters",
            "config",
            "env"
          ]
        }
      },
      "env": {
        "dependencies": {
          "allow": ["env", "config"]
        }
      }
    }
  }
}
