{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", "**/*.tsbuildinfo", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "DATABASE_ADMIN_URL", "CI"],
      "cache": false
    },
    "//#lint": {
      "cache": false
    },
    "lint": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "openapi": {
      "dependsOn": ["build"],
      "outputs": ["openapi/**"]
    }
  },
  "boundaries": {
    "tags": {
      "domain": {
        "dependencies": {
          "allow": ["domain", "config"]
        }
      },
      "contracts": {
        "dependencies": {
          "allow": ["contracts", "domain", "config"]
        }
      },
      "data": {
        "dependencies": {
          "allow": ["data", "contracts", "domain", "config"]
        }
      },
      "db": {
        "dependencies": {
          "allow": ["db", "config"]
        }
      },
      "theme": {
        "dependencies": {
          "allow": ["theme", "config"]
        }
      },
      "i18n": {
        "dependencies": {
          "allow": ["i18n", "contracts", "domain", "config"]
        }
      },
      "ui": {
        "dependencies": {
          "allow": ["ui", "contracts", "domain", "theme", "config"]
        }
      },
      "forms": {
        "dependencies": {
          "allow": ["forms", "config"]
        }
      },
      "app-web": {
        "dependencies": {
          "allow": [
            "app-web",
            "contracts",
            "data",
            "domain",
            "env",
            "forms",
            "i18n",
            "theme",
            "ui",
            "config"
          ]
        }
      },
      "app-mobile": {
        "dependencies": {
          "allow": [
            "app-mobile",
            "contracts",
            "data",
            "domain",
            "env",
            "forms",
            "i18n",
            "theme",
            "ui",
            "config"
          ]
        }
      },
      "app-api": {
        "dependencies": {
          "allow": ["app-api", "contracts", "domain", "db", "env", "config"]
        }
      },
      "app-worker": {
        "dependencies": {
          "allow": ["app-worker", "contracts", "domain", "db", "env", "config", "adapters"]
        }
      },
      "app-invariants": {
        "dependencies": {
          "allow": ["app-invariants", "contracts", "domain", "db", "env", "config"]
        }
      },
      "env": {
        "dependencies": {
          "allow": ["env", "config"]
        }
      }
    }
  }
}
