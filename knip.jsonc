{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // JSONC so every allowlist entry carries its reason — a suppression nobody can justify
  // is how a tool stops being read. Knip is local hygiene, never a CI gate,
  // so its only value is signal: true positives stay VISIBLE, never suppressed.
  // Keep this minimal — knip infers most entries and flags redundant ones as hints.

  "ignoreWorkspaces": ["packages/config"],

  "workspaces": {
    // These two are RUN by package.json scripts, and knip cannot infer either: the openapi
    // script invokes the BUILT `dist/scripts/emit-openapi.js`, and migrate is a tsx entry.
    // Dropping them made both files report as dead code.
    "packages/contracts": { "entry": ["src/scripts/*.ts"], "project": "src/**/*.ts" },
    "packages/db": { "entry": ["src/migrate.ts"], "project": "src/**/*.ts" },

    // build.ts is RUN by the package build script (tsx), never imported; src/index.ts is the
    // package entry. src/_generated is data (css/json, plus the DS typings as .d.ts.txt —
    // see that folder's README for why the contracts carry a .txt suffix), so the whole
    // folder sits outside the `src/**/*.ts` project glob and needs no exclusion here.
    "packages/theme": { "entry": ["build.ts", "src/index.ts"], "project": "src/**/*.ts" },

    // ONE package, both platforms (docs/17 §2). src/index.ts is inferred from the manifest;
    // the .native.tsx halves are extra ENTRIES because Metro substitutes them for the .tsx
    // halves at bundle time, so from the web entry alone knip would call them dead files.
    // react-dom is an optional peer the WEB half references (Portal.tsx createPortal);
    // Metro never resolves that file, which is exactly why the peer is optional.
    "packages/ui": {
      "entry": ["src/**/*.native.tsx"],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": ["react-dom"]
    },

    // `features/**` stays listed though the folder is currently EMPTY: it was missing until
    // 2026-08-02 and knip then saw roughly a tenth of this app, reporting four live
    // dependencies as unused. Re-created feature folders must be covered from day one.
    //
    // app/providers.tsx is deliberately NOT an entry: layout.tsx imports it, and listing it
    // would mark its exports public and hide the genuinely-dead `useLocale`.
    // `zod` stays in both app manifests WITHOUT being imported: the explicit pin is what
    // stops pnpm resolving @ts-rest's peer to the transitive zod 4 (mobile CLAUDE.md
    // landmine, hit 2026-07-27), while direct app imports are Biome-banned — the bundler's
    // zod is a different instance from the one installFormsErrorMap configures (2026-08-02).
    "apps/web": {
      "project": "{app,features,lib}/**/*.{ts,tsx}",
      "ignoreDependencies": ["zod"]
    },

    // src/ui/index.ts was this app's component API until 2026-08-19. The V2 design system
    // is ONE package (packages/ui) holding both platforms, so RN has no local mirror and
    // no second entry here.
    "apps/mobile": {
      "entry": ["App.tsx"],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": ["zod"]
    },

    "tests/invariants": { "entry": ["src/run.ts"], "project": "src/**/*.ts" },

    // The gate scripts are RUN by package.json and lint-all.sh, never imported — entries,
    // not orphans. Listing them is what stopped knip calling three live gates dead code.
    ".": { "entry": ["scripts/*.mjs"], "project": "scripts/*.mjs" }
  },

  "ignore": [
    // Asserts root.tsx's module augmentation landed, so `useNavigation()`
    // stays typed. Checked by tsc (which reads every file under src/), imported by nothing.
    "apps/mobile/src/navigation/route-typing.ts",
    // Read by the lingui CLI (`extract`/`compile`), never imported by TypeScript.
    "packages/i18n/lingui.config.js"
  ],

  "ignoreDependencies": [
    // tsconfig/biome presets — resolved by path from config files, never imported.
    "@heliogrid/config"
  ]
}
