{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check:*)",
      "Bash(pnpm verify)",
      "Bash(pnpm turbo *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm boundaries)",
      "Bash(pnpm --filter @heliogrid/* build)",
      "Bash(pnpm --filter @heliogrid/* typecheck)",
      "Bash(pnpm --filter @heliogrid/* test)",
      "Bash(pnpm --filter @heliogrid/* dev)",
      "Bash(pnpm --filter @heliogrid/* start)",
      "Bash(pnpm --filter @heliogrid/* bundle)",
      "Bash(pnpm --filter @heliogrid/* extract)",
      "Bash(pnpm --filter @heliogrid/* openapi)",
      "Bash(pnpm --filter @heliogrid/* migrate)",
      "Bash(pnpm --filter @heliogrid/* pack:publish)",
      "Bash(pnpm install)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(node scripts/*)",
      "Bash(pnpm verify:clean)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm infra:token)",
      "Bash(pnpm ds:contract)",
      "Bash(pnpm dupes:*)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-applied-migration-edit.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-lockfile-edit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-test-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-no-verify.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-db-write.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-push.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-unverified-commit.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  }
}
