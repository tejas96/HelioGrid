{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check:*)",
      "Bash(pnpm turbo *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm --filter @heliogrid/* build)",
      "Bash(pnpm --filter @heliogrid/* typecheck)",
      "Bash(pnpm --filter @heliogrid/* test)",
      "Bash(pnpm --filter @heliogrid/* dev)",
      "Bash(pnpm --filter @heliogrid/* start)",
      "Bash(pnpm --filter @heliogrid/* bundle)",
      "Bash(pnpm --filter @heliogrid/* extract)",
      "Bash(pnpm --filter @heliogrid/* openapi)",
      "Bash(pnpm --filter @heliogrid/* migrate)",
      "Bash(pnpm --filter @heliogrid/* pack:publish)",
      "Bash(pnpm install)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm infra:token)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(curl -i http://localhost:8084/*)",
      "Bash(docker exec heliogrid-pg-local psql -U qa_readonly -d heliogrid_dev -qtAc *)",
      "Bash(idb ui describe-all --udid *)",
      "Bash(xcrun simctl io * screenshot *)",
      "Bash(xcrun simctl keychain * reset)",
      "Bash(xcrun simctl list devices *)",
      "Bash(sips -z *)",
      "Bash(adb devices)",
      "Bash(adb -s * shell input *)",
      "Bash(adb -s * shell uiautomator dump *)",
      "Bash(adb -s * shell cat /sdcard/*)",
      "Bash(adb -s * logcat -d*)",
      "Bash(adb -s * exec-out screencap *)",
      "Bash(adb -s * shell cmd connectivity airplane-mode enable)",
      "Bash(adb -s * shell cmd connectivity airplane-mode disable)",
      "Bash(adb -s * shell am force-stop com.heliogrid.app)",
      "Bash(xcrun simctl terminate * com.heliogrid.app)",
      "Bash(lsof -nP -iTCP:3002 -iTCP:8084 -iTCP:8081 -sTCP:LISTEN -t)",
      "Bash(pgrep -f *)",
      "Bash(perl -e 'sleep shift' *)",
      "Bash(date -u +%FT%TZ)"
    ],
    "deny": [
      "Bash(curl * -o*)",
      "Bash(curl * --output*)",
      "Bash(curl * -O*)",
      "Bash(curl * --remote-name*)",
      "Bash(curl * -T*)",
      "Bash(curl * --upload-file*)",
      "Bash(curl * -K*)",
      "Bash(curl * --config*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-applied-migration-edit.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-lockfile-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-no-verify.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-db-write.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-push.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  }
}
