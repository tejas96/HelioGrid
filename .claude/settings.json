{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit -an*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git commit * --no-verify*)",
      "Bash(*SKIP_SIMPLE_GIT_HOOKS=*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh api *pulls/*/merge*)",
      "Edit(pnpm-lock.yaml)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(docker compose * down -v*)",
      "Bash(docker compose * down --volumes*)",
      "Bash(pnpm infra:reset*)",
      "Bash(pkill*)",
      "Bash(killall*)",
      "Bash(kill-port*)",
      "Bash(* xargs kill*)",
      "Bash(kill *)",
      "Bash(rm -rf /Volumes/works-space/heliogrid*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)"
    ]
  }
}
