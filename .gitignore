# Dependencies
node_modules/
.pnpm-store/

# Build outputs (generated, never committed)
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Env — secrets never committed; .env.example documents every var
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# React Native
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/vendor/
apps/mobile/.bundle/config
*.xcuserdata
*.xcworkspace/xcuserdata/

# Playwright / test artifacts
playwright-report/
test-results/

# Subagent-driven-development workspace (ledger, briefs, review packages)
.superpowers/

# QA writes nothing to the tree (owner ruling 2026-08-03): /verify keeps its artifacts in the
# session scratchpad and deletes them when the run ends. The verification record lives in the
# PR body.
# These two entries are legacy guards, not live conventions — the retired /qa system left
# local artifacts on machines that ran it. Keeping them ignored stops a stale run being
# committed, and keeps Biome (vcs.useIgnoreFile) from linting generated JSON. Delete the
# directories when convenient; nothing recreates them.
.qa/
.playwright-mcp/

# graphify — generated knowledge-graph cache, never committed
graphify-out/
