# Dependencies
node_modules/
.pnpm-store/

# Build outputs (generated, never committed)
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Env — secrets never committed; .env.example documents every var
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# React Native
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/vendor/
apps/mobile/.bundle/config
*.xcuserdata
*.xcworkspace/xcuserdata/

# Playwright / test artifacts
playwright-report/
test-results/

# Subagent-driven-development workspace (ledger, briefs, review packages)
.superpowers/

# QA runs — ENTIRELY local (owner ruling 2026-08-02). Plans, reports, triage and evidence
# all stay out of git; QA output is for the person running it, not for sharing.
# This REPLACES the earlier rule that kept plan/report/triage as committed history — that
# rule's warning comment ("do not widen this to .qa") is superseded, not overlooked.
# Consequence, stated because it is silent otherwise: the repo no longer carries a record of
# what was verified. A slice's evidence lives only in the working tree of whoever ran it.
.qa/

# Playwright MCP scratch (console logs, traces), written during /qa runs
.playwright-mcp/

# graphify — generated knowledge-graph cache, never committed
graphify-out/
