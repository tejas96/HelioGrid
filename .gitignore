# Dependencies
node_modules/
.pnpm-store/

# Build outputs (generated, never committed)
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Env — secrets never committed; .env.example documents every var
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# React Native
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/vendor/
apps/mobile/.bundle/config
*.xcuserdata
*.xcworkspace/xcuserdata/

# Playwright / test artifacts — the component suite's build lands in playwright/.cache/
playwright-report/
test-results/
playwright-report-ct/
test-results-ct/
tests/e2e/playwright/.cache/
# A web look drawn on a Mac (a local run with CI set): the baselines are CI's Linux renders only.
tests/e2e/web/*-snapshots/*-darwin.png

# Python bytecode.
__pycache__/
*.pyc

# Planning-plugin working files, if that plugin is ever enabled — its briefs, specs, plans and
# subagent scratch, under ONE root. Plugin-internal process state, not repo documentation: the
# code and the PR carry what the repo needs to know. The line stays so that enabling it never
# drops process scratch into the tree.
.superpowers/

# The Playwright MCP's scratch output.
.playwright-mcp/

# graphify — generated knowledge-graph cache, never committed
graphify-out/
drizzle-draft/

# Signed dev JWT for Temporal, written by `pnpm infra:token`. One hour TTL, minted from the
# gitignored infra/temporal/pki/jwt key. Never committed — a token in a diff is a credential
# in the history. The glob also covers the .tmp the mint writes before moving it into place.
.temporal-token*

# Vitest coverage output — regenerated by `pnpm test:coverage`, never committed.
coverage/

# Tools installed locally by hand (never committed).
.tools/

# The api's development log, `.qa/api.log`.
.qa/

# The owner's private infra record: every external account, project, client id and what is still owed.
.ops/
