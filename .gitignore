# Dependencies
node_modules/
.pnpm-store/

# Build outputs (generated, never committed)
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Env — secrets never committed; .env.example documents every var
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# React Native
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/vendor/
apps/mobile/.bundle/config
*.xcuserdata
*.xcworkspace/xcuserdata/

# Playwright / test artifacts
playwright-report/
test-results/

# Python bytecode. scripts/ gained it when gates.py and next-screen.py moved there.
__pycache__/
*.pyc

# Planning-plugin working files — its briefs, specs, plans and subagent scratch, all under
# ONE root. Plugin-internal process state, not repo documentation: the code and the PR carry
# what the repo needs to know. The plugin's skills default to docs/superpowers/; CLAUDE.md §8
# overrides that to here, so this stays out of the documentation tree.
.superpowers/

# QA writes nothing to the tree (owner ruling 2026-08-03): /verify keeps its artifacts in the
# session scratchpad and deletes them when the run ends. The verification record lives in the
# PR body.
# These entries are legacy guards only — the retired /qa system wrote here, and its leftovers
# were deleted from this machine on 2026-08-03. Nothing recreates either path; they stay
# ignored so a stale checkout elsewhere cannot commit one or make Biome lint generated JSON.
.qa/
.playwright-mcp/

# graphify — generated knowledge-graph cache, never committed
graphify-out/
